---
import Title from "@ui/Title.astro";
import Section2 from "@ui/Section2.astro";
---
<Section2 id="connect" variant="dark" className="connect-section">
  <div class="connect-bg" aria-hidden="true"></div>
  <div class="connect-inner">

    <div class="sec-header connect-header">
      <Title id="connect" subtitle="Want to collaborate or contribute? We're open to partnership opportunities and would love to hear your ideas.">LET'S CONNECT</Title>
    </div>

    <div class="connect-grid">

      <div class="connect-block">
        <div class="connect-block-title">Newsletter</div>
        <form class="connect-newsletter-form" id="subscribeForm">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input type="email" id="newsletter-email" class="connect-newsletter-input" placeholder="your@email.com">
          <button type="submit" class="connect-newsletter-btn">Subscribe</button>
        </form>
        <p class="connect-newsletter-note">Get the latest updates, speaker announcements, and special deals. No spam, unsubscribe anytime.</p>
      </div>

      <div class="connect-block">
        <div class="connect-socials">
          <a href="https://x.com/europython" class="connect-social-link" title="X / Twitter">
            <i class="fab fa-x-twitter"></i>
            <span>X</span>
          </a>
          <a href="https://fosstodon.org/@europython" class="connect-social-link" title="Mastodon">
            <i class="fab fa-mastodon"></i>
            <span>Mastodon</span>
          </a>
          <a href="https://bsky.app/profile/europython.eu" class="connect-social-link" title="Bluesky">
            <i class="fab fa-bluesky"></i>
            <span>Bluesky</span>
          </a>
          <a href="https://linkedin.com/company/europython" class="connect-social-link" title="LinkedIn">
            <i class="fab fa-linkedin-in"></i>
            <span>LinkedIn</span>
          </a>
          <a href="https://instagram.com/europython" class="connect-social-link" title="Instagram">
            <i class="fab fa-instagram"></i>
            <span>Instagram</span>
          </a>
          <a href="https://youtube.com/channel/UC98CzaYuFNAA_gOINFB0e4Q" class="connect-social-link" title="YouTube">
            <i class="fab fa-youtube"></i>
            <span>YouTube</span>
          </a>
          <a href="https://github.com/europython" class="connect-social-link" title="GitHub">
            <i class="fab fa-github"></i>
            <span>GitHub</span>
          </a>
        </div>
      </div>


    </div>

  </div>
</Section2>

<script>
  const form = document.getElementById("subscribeForm");
  form?.addEventListener("submit", handleSubscribe);

  async function handleSubscribe(event) {
    event.preventDefault();

    const input = document.getElementById("newsletter-email");
    if (!(input instanceof HTMLInputElement)) return;

    const email = input.value.trim();
    if (!email) return;

    try {
      const result = await fetch("https://blog.europython.eu/members/api/send-magic-link/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, emailType: "subscribe" })
      });

      const r = await result.text();
      if (r === "Created.") {
        input.value = "";
        alert("Please check your email to confirm. 📬");
      }
    } catch {}
  }
</script>

