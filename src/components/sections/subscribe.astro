---
import Button from "@ui/Button.astro";
import Section from "@ui/Section.astro"
const socialLinks = [
{ href: "https://www.linkedin.com/company/europython/", icon: "linkedin", label: "LinkedIn" },
  { href: "https://www.instagram.com/europython/", icon: "instagram", label: "Instagram" },
  { href: "https://www.youtube.com/channel/UC98CzaYuFNAA_gOINFB0e4Q", icon: "youtube", label: "YouTube" },
  { href: "https://fosstodon.org/@europython", icon: "mastodon", label: "Mastodon" },
  { href: "https://bsky.app/profile/europython.eu", icon: "bluesky", label: "Bluesky" },
  { href: "https://www.tiktok.com/@europython/", icon: "tiktok", label: "TikTok" },
  { href: "https://x.com/europython", icon: "x", label: "X (formerly Twitter)" },
];
---

<Section variant="primary">
<div class="flex flex-col items-center justify-center py-08 px-4 text-center">
  <div class="w-full flex flex-col items-center justify-center py-20 px-4 text-center relative z-10">
    <h1 class="text-4xl md:text-6xl font-bold mb-10 leading-tight text-[#17223A]">
      Follow us<br />for updates!
    </h1>

    <div class="flex justify-center flex-wrap gap-6 mb-8">
      {socialLinks.map(({ href, icon, label }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="w-16 h-16 flex items-center justify-center border-2 rounded-full hover:scale-110 transition-transform"
          aria-label={`Visit our ${label} page`}
        >
          <i class={`fab fa-${icon} text-2xl text-[#17223A]`}></i>
        </a>
      ))}
    </div>

    <p class="text-[#151f38] mb-8 text-sm md:text-base">
      Subscribe to our conference newsletter and get<br />
      the latest updates and special deals
    </p>

    <form
      id="subscribeForm"
      class="flex flex-col sm:flex-row justify-center items-center gap-4"
    >
      <label for="emailInput" class="sr-only">Email address</label>
      <input
        id="emailInput"
        type="email"
        name="email"
        placeholder="Your email"
        required
        class="px-4 py-3 rounded-[10px] bg-white text-black text-base font-medium w-72 text-center"
      />

      <Button outline type="submit"> Subscribe </Button>
    </form>

    <p
      id="subscribeMessage"
      class="hidden mt-4 text-green-600 text-lg font-medium transition-opacity duration-500 opacity-0"
    >
      Please check your email to confirm. 📬
    </p>
  </div>
</div>
</Section>

<script>
  const form = document.getElementById("subscribeForm");
  const message = document.getElementById("subscribeMessage");

  form?.addEventListener("submit", handleSubscribe);

  async function handleSubscribe(event: SubmitEvent) {
    event.preventDefault();

    const input = document.getElementById("emailInput");
    if (!(input instanceof HTMLInputElement)) return;

    const email = input.value.trim();
    if (!email) return;

    try {
      const result = await fetch("https://blog.europython.eu/members/api/send-magic-link/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, emailType: "subscribe" })
      });

      const r = await result.text();
      if (r === "Created.") {
        input.value = "";

        message?.classList.remove("hidden");
        setTimeout(() => message?.classList.add("opacity-100"), 50);

        setTimeout(() => {
          message?.classList.remove("opacity-100");
          setTimeout(() => message?.classList.add("hidden"), 500);
        }, 5000);
      }
    } catch {
    }
  }
</script>
