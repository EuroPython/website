---
import Section2 from "@ui/Section2.astro";
import Display from "@ui/Display.astro";
---

<Section2 id="orgsummit" variant="dark" className="orgsummit-section">
  <div class="orgsummit-bg" aria-hidden="true"></div>
  <div class="split-layout orgsummit-inner">
    <div class="split-left orgsummit-left">
      <Display
        id="orgsummit"
        span="SUMMIT"
        spanColor="var(--color-green-2e)"
        subtitle="A dedicated day for Python conference and community organisers from across Europe — bigger and better than ever before."
        >CONFERENCE<br />ORGANISERS</Display
      >
      <a href="#" class="orgsummit-cta">Learn more</a>
    </div>

    <ul class="event-list orgsummit-events">
      <li>
        <strong>Organisers Meetup — Friday 17 July</strong>
        Gather with fellow PyCon and PyO organisers from across Europe. Share what's
        working, what isn't, and what's next for your community.
      </li>
      <li>
        <strong>Community Lunch — Friday 17 July, 13:00–14:00</strong>
        Sit down together over a shared meal. An informal space to connect with peers,
        swap stories, and build lasting relationships.
      </li>
      <li>
        <strong>Open Space Sessions — Friday 17 July, Afternoon</strong>
        Unconference-style discussions on running events, growing communities, diversity,
        sponsorship, and everything in between.
      </li>
      <li>
        <strong>More activities to be announced</strong>
        We're making this year's summit bigger than EP2025. Stay tuned for additional
        programming.
      </li>
    </ul>
  </div>
</Section2>

<style>
  :global(.orgsummit-section) {
    background: var(--color-section-bg);
  }

  .orgsummit-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(
          ellipse 80% 60% at 10% 50%,
          oklch(0.622 0.158 152.5 / 0.1) 0%,
          transparent 60%
        )
        /* #14a050 */,
      radial-gradient(
          ellipse 50% 80% at 90% 20%,
          oklch(0.435 0.108 154.8 / 0.07) 0%,
          transparent 55%
        )
        /* #0a6432 */;
  }

  .split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    position: relative;
    z-index: 1;
  }

  .split-left {
    top: 2rem;
  }

  @media (max-width: 900px) {
    .split-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .split-left {
      position: static;
    }
  }

  .orgsummit-cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    background: linear-gradient(
      to bottom,
      var(--color-green-2e),
      var(--color-green-25)
    );
    color: var(--color-section-bg);
    border: 1px solid var(--color-green-2e);
    border-radius: 2px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .orgsummit-cta:hover {
    opacity: 0.85;
  }

  .event-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .event-list li {
    padding: 1.4rem 1.8rem 1.4rem 0;
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    border-bottom: 1px dashed var(--color-border);
  }

  .event-list li:last-child {
    border-bottom: none;
  }

  .event-list li strong {
    display: block;
    font-weight: 800;
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }
</style>
