---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Button from "@ui/Button.astro";

export interface Props {
  title: string;
  subtitle: string;
  url: string;
  image: ImageMetadata;
}

const { title, subtitle, url, image } = Astro.props;
---

<div
  class="prose-xl min-w-[250px] w-full md:w-[40%] lg:w-[30%] p-4 bg-[#E8F4F8] rounded-2xl text-center flex flex-col max-w-[360px]"
>
    <div class="relative w-full">
      <Image
        src={image}
        width={600}
        height={375}
          alt=`Card image - ${title}`
        class="not-prose rounded-xl w-full"
        loading="lazy"
      />
    </div>
  <div class="flex items-center flex-col flex-grow mb-2">
    <h3 >{title}</h3>
    <slot />
  </div>

  <Button secondary url={url}>{subtitle}</Button>
</div>
