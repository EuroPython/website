---
import Section2 from "@ui/Section2.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

let deadlineEntries = await getCollection("deadlines");
deadlineEntries = deadlineEntries
  .filter((d) => !d.data.disabled)
  .sort((a, b) => a.id.localeCompare(b.id))
  .reverse()
  .slice(0, 3);

const cards = await Promise.all(
  deadlineEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { data: entry.data, Content };
  })
);
---

<Section2 className="news-section" variant="dark-alt" id="updates">

    <div class="news-grid">
      {cards.map(({ data, Content }) => (
        <div class="news-card">
          {data.image && (
            <div class="news-image">
              <Image
                src={data.image}
                alt={data.title}
                width={600}
                height={375}
                class="news-img"
                loading="lazy"
              />
            </div>
          )}
          <div class="news-title">{data.title}</div>
          <div class="news-desc"><Content /></div>
          <a
            href={data.url}
            class="news-cta"
            style={data.disabled ? "opacity: 0.4; pointer-events: none;" : ""}
          >
            {data.subtitle}
          </a>
        </div>
      ))}
    </div>
</Section2>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .news-card {
    padding: 1.4rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
    align-items: center;
    transition: transform 0.35s var(--ease-premium, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .news-image {
    width: 100%;
    border-radius: 2px;
    overflow: hidden;
  }

  .news-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    border-radius: 2px;
    transition: transform 0.5s var(--ease-premium, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .news-card:hover .news-img {
    transform: scale(1.05);
  }

  .news-title {
    font-size: 1.4rem;
    color: var(--color-text);
    line-height: 1.25;
  }

  .news-desc {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .news-cta {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: var(--color-accent-themed);
    color: var(--color-on-accent);
    border: 1px solid var(--color-accent-themed);
    border-radius: 2px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .news-cta:hover {
    opacity: 0.85;
  }

  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
