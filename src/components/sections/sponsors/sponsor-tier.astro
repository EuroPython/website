---
import { getCollection } from "astro:content";
import SponsorLogo from "@components/SponsorLogo.astro";

type Sponsor = Awaited<ReturnType<typeof getCollection<"sponsors">>>[0];

export interface Props {
  tier: {
    name: string;
    sponsors: Sponsor[];
  };

  level: number;
}

const { tier, level = 2 } = Astro.props;
const special_event = tier.name === "Special Event";
---

<div class="relative">
  <h3 class="absolute w-10 font-bold top-0 bottom-0 font-title text-primary">
    <span
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-90 block origin-center whitespace-nowrap"
    >
      {tier.name}
    </span>
  </h3>
  <div
    class:list={[
      "grid ml-12 items-center justify-items-center",
      `level-${level}`,
      {
        "grid-cols-1 md:grid-cols-2 m-10 [&>*]:scale-110": level === 0,
        "grid-cols-1 md:grid-cols-2 lg:grid-cols-3 [&>*]:scale-90":
          level > 0 && level < 6,
        "grid-cols-1 md:grid-cols-3 lg:grid-cols-4 [&>*]:scale-70":
          level >= 6 && level < 7,
        "grid-cols-1 md:grid-cols-3 lg:grid-cols-4 [&>*]:scale-85": level >= 7,
      },
    ]}
  >
    {
      tier.sponsors.map((sponsor) => (
        <SponsorLogo sponsor={sponsor.id} {special_event} />
      ))
    }
  </div>
</div>
