---
import Keynoter from "./keynoters/keynoter.astro";
import { getCollection } from "astro:content";

const allKeynoters = await getCollection("keynoters");
const keynoters = allKeynoters.sort((a, b) => a.data.order - b.data.order);

const placeholderCount = Math.max(0, 6 - keynoters.length);
const placeholders = Array.from({ length: placeholderCount }, (_, i) => ({
  name: "",
  url: "",
  order: keynoters.length + i + 1,
}));
---

<section class="sec-wrap prog-section" id="programme">
  <div class="sec-inner prog-inner">

    <div class="sec-header prog-section-header">
      <h2 class="sec-title prog-section-title">What to Expect? <sup class="sec-anchor"><a href="#programme">#</a></sup></h2>
      <p class="prog-topics-label">A Week of All Things Python!</p>
    </div>

    <div class="prog-grid">
      <div class="prog-card">
        <div class="prog-card-date">
          <div class="prog-card-date-main">13th &amp; 14th July</div>
          <div class="prog-card-date-days">Monday &amp; Tuesday</div>
        </div>
        <div class="prog-card-body">
          <h3 class="prog-card-title"><a href="/tutorials/">Tutorials &amp; Summits</a></h3>
          <p class="prog-card-desc">Full-day deep dives with an expert in a small group. Far more hands-on than a talk. Sold separately.</p>
          <a href="/tutorials/" class="prog-card-btn">Browse tutorials</a>
        </div>
      </div>
      <div class="prog-card">
        <div class="prog-card-date">
          <div class="prog-card-date-main">15th – 17th July</div>
          <div class="prog-card-date-days">Wednesday, Thursday &amp; Friday</div>
        </div>
        <div class="prog-card-body">
          <h3 class="prog-card-title"><a href="/schedule/">Main Conference</a></h3>
          <p class="prog-card-desc">100+ talks across five parallel tracks. Keynotes, open spaces, and social events. The heart of EuroPython.</p>
          <a href="/schedule/" class="prog-card-btn">Full conference schedule</a>
        </div>
      </div>
      <div class="prog-card">
        <div class="prog-card-date">
          <div class="prog-card-date-main">18th &amp; 19th July</div>
          <div class="prog-card-date-days">Saturday &amp; Sunday</div>
        </div>
        <div class="prog-card-body">
          <h3 class="prog-card-title"><a href="/programme/#sprints">Sprints &amp; Workshops</a></h3>
          <p class="prog-card-desc">Contribute to real Python projects alongside the people who maintain them. Beginners welcome!</p>
          <a href="/programme/#sprints" class="prog-card-btn">Sprints info</a>
        </div>
      </div>
    </div>

    <div class="prog-topics">
      <p class="prog-topics-label">Conference Topics</p>
      <div class="topics-grid">
        <a href="/talks/#topic-python-core" class="topic-tag">Python Core &amp; Internals</a>
        <a href="/talks/#topic-web" class="topic-tag">Web Dev &amp; APIs</a>
        <a href="/talks/#topic-devops" class="topic-tag">DevOps &amp; Cloud</a>
        <a href="/talks/#topic-iot" class="topic-tag">IoT &amp; Embedded</a>
        <a href="/talks/#topic-tooling" class="topic-tag">Tooling &amp; Packaging</a>
        <a href="/talks/#topic-testing" class="topic-tag">Testing &amp; Security</a>
        <a href="/talks/#topic-community" class="topic-tag">Community &amp; Education</a>
        <a href="/talks/#topic-ethics" class="topic-tag">Ethics &amp; Sustainability</a>
        <a href="/talks/#topic-careers" class="topic-tag">Careers &amp; Leadership</a>
        <a href="/talks/#topic-games" class="topic-tag">Games, Art &amp; Play</a>
        <a href="/talks/#topic-ml" class="topic-tag">Machine Learning</a>
        <a href="/talks/#topic-nlp" class="topic-tag">NLP &amp; Computer Vision</a>
        <a href="/talks/#topic-data" class="topic-tag">Data &amp; Visualisation</a>
        <a href="/talks/#topic-jupyter" class="topic-tag">Jupyter &amp; Scientific Python</a>
        <a href="/talks/#topic-data-eng" class="topic-tag">Data Engineering &amp; MLOps</a>
      </div>
    </div>

    <div class="prog-events">
      <p class="prog-topics-label">More than just talks</p>
      <p class="prog-events-desc">EuroPython is a full week of community — from dedicated community days and social events to open spaces, workshops, and sprints.</p>
      <div class="prog-events-list">
        <a href="/programme/#beginners-day" class="prog-event-btn" style="--event-color: #3ab8ff">Beginners' Day</a>
        <a href="/programme/#open-spaces" class="prog-event-btn" style="--event-color: #f0c040">Open Spaces</a>
        <a href="/programme/#lightning-talks" class="prog-event-btn" style="--event-color: #af6ae0">Lightning Talks</a>
        <a href="/programme/#pyladies" class="prog-event-btn" style="--event-color: #d42027">PyLadies Events</a>
        <a href="/programme/#orgsummit" class="prog-event-btn" style="--event-color: #2ecc71">Organisers Summit</a>
        <a href="/programme/#lang-summit" class="prog-event-btn" style="--event-color: #3c78c8">Language Summit</a>
        <a href="/programme/#rust-summit" class="prog-event-btn" style="--event-color: #de5833">Rust Summit</a>
        <a href="/programme/#pkg-summit" class="prog-event-btn" style="--event-color: #cc9900">Packaging Summit</a>
        <a href="/programme/#wasm-summit" class="prog-event-btn" style="--event-color: #7a4e9e">WASM Summit</a>
        <a href="/participate/#tickets" class="prog-event-btn" style="--event-color: #f0c040">Social Event</a>
        <a href="/participate/#tickets" class="prog-event-btn" style="--event-color: #f0c040">Speaker Dinner</a>
        <a href="/participate/#volunteering" class="prog-event-btn" style="--event-color: #f0c040">Volunteering</a>
      </div>
    </div>

    <div class="prog-keynoters">
      <p class="prog-topics-label">Keynote Speakers</p>
      <ul class="prog-keynoters-grid">
        {keynoters.map((k) => (
          <Keynoter
            name={k.data.name}
            url={k.data.url || ""}
            tagline={k.data.tagline}
            bio={k.data.bio}
            image={k.data.image}
            order={k.data.order}
          />
        ))}
        {placeholders.map((p) => (
          <Keynoter
            name={p.name}
            url={p.url}
            order={p.order}
            placeholder={true}
          />
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .sec-wrap {
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .sec-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4.5rem 2rem;
    position: relative;
    z-index: 1;
  }

  .prog-section {
    background: var(--color-section-bg-alt, #070b14);
  }

  .prog-section-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .sec-title {
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
    text-transform: uppercase;
    position: relative;
  }

  .sec-title .sec-anchor {
    font-size: 0.5em;
    vertical-align: super;
    margin-left: 0.15em;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .sec-title:hover .sec-anchor {
    opacity: 0.5;
  }

  .sec-title .sec-anchor a {
    color: #fff;
    text-decoration: none;
  }

  .prog-topics-label {
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: 1.4rem;
    color: var(--color-cream, #fff5f0);
    margin-top: 1rem;
    margin-bottom: 1.2rem;
    text-align: center;
  }

  .prog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .prog-card {
    text-align: center;
    border: 1px dashed var(--color-border-dark, rgba(255,255,255,0.10));
    border-radius: 2px;
  }

  .prog-card-date {
    padding: 1.8rem 1.4rem;
    border-bottom: 1px dashed var(--color-border-dark, rgba(255,255,255,0.10));
  }

  .prog-card-date-main {
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: 1.55rem;
    color: var(--color-cream, #fff5f0);
    margin-bottom: 0.3rem;
    line-height: 1.2;
  }

  .prog-card-date-days {
    font-size: 1.1rem;
    color: var(--color-text-muted-dark, rgba(255,255,255,0.70));
  }

  .prog-card-body {
    padding: 1.6rem 1.4rem 2rem;
  }

  .prog-card-title {
    font-family: var(--font-dm-sans, 'DM Sans', system-ui, sans-serif);
    font-size: 1.44rem;
    font-weight: 700;
    color: var(--color-accent, #f0c040);
    margin-bottom: 0.7rem;
    line-height: 1.2;
    letter-spacing: 0.03em;
  }

  .prog-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .prog-card-desc {
    font-size: 1.1rem;
    color: var(--color-text-primary-dark, rgba(255,255,255,0.93));
    line-height: 1.65;
    margin-bottom: 0.8rem;
  }

  .prog-card-btn {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border: 1px solid var(--color-accent, #f0c040);
    border-radius: 2px;
    color: var(--color-accent, #f0c040);
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: 0.95rem;
    text-decoration: none;
    transition: opacity 0.2s;
    background: transparent;
  }

  .prog-card-btn:hover {
    opacity: 0.8;
  }

  .prog-topics {
    margin-top: 3rem;
    text-align: center;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .topic-tag {
    font-family: var(--font-dm-sans, 'DM Sans', system-ui, sans-serif);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--color-text-secondary-dark, rgba(255,255,255,0.78));
    text-decoration: none;
    background: var(--color-surface-medium, rgba(255,255,255,0.08));
    border: 1px dashed var(--color-border-dark, rgba(255,255,255,0.10));
    border-radius: 2px;
    padding: 0.35em 1.1em;
    transition: background 0.15s, color 0.15s;
    opacity: 0.7;
    text-align: center;
  }

  .topic-tag:hover {
    opacity: 1;
    background: var(--color-accent, #f0c040);
    color: var(--color-section-bg, #080f1a);
    border-color: var(--color-accent, #f0c040);
  }

  .prog-keynoters {
    margin-top: 4rem;
  }

  .prog-keynoters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 1px dashed var(--color-border-dark, rgba(255,255,255,0.10));
    border-radius: 2px;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .prog-keynoters-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .prog-keynoters-grid {
      grid-template-columns: 1fr;
    }
  }

  .prog-events {
    margin-top: 4rem;
    text-align: center;
  }

  .prog-events-desc {
    font-size: 1.15rem;
    color: var(--color-text-muted-dark, rgba(255,255,255,0.70));
    margin-bottom: 1.5rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .prog-events-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .prog-event-btn {
    display: inline-block;
    padding: 0.6rem 1rem;
    border: 1px solid var(--event-color);
    border-radius: 2px;
    color: var(--event-color);
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.2s, box-shadow 0.2s;
    background: transparent;
    opacity: 0.85;
    text-align: center;
  }

  .prog-event-btn:hover {
    opacity: 1;
    box-shadow: 0 0 40px var(--event-color);
  }

  @media (max-width: 900px) {
    .prog-grid {
      grid-template-columns: 1fr;
    }
    .prog-events-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .prog-events-list {
      grid-template-columns: 1fr;
    }
    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
