---
import { Picture } from "astro:assets";
import Section from "@ui/Section.astro";
import Headline from "@ui/Headline.astro";
import Button from "@ui/Button.astro";
import Logo from "/public/krakow.svg";

// Import images
const images = [
  {
    src: "/krakow/Wiosna, Akademia Muzyczna, widok na Stare Miasto_M6B6817-fot. Ela Marchewka_horizontal.jpg",
    alt: "Spring panoramic view of Old Town from Music Academy, Kraków",
    orientation: "horizontal",
    gridArea: "img1"
  },
  {
    src: "/krakow/Lato, ul. Kanonicza, Wawel_M6B0798-fot. Ela Marchewka.jpg",
    alt: "Summer view of Kanonicza Street with Wawel Castle in the background, Kraków",
    orientation: "vertical",
    gridArea: "img2"
  },
  {
    src: "/krakow/Wawel-DJI_0293-fot. Ela Marchewka.jpg",
    alt: "Aerial view of Wawel Castle and cathedral complex, Kraków",
    orientation: "vertical",
    gridArea: "img3"
  },
  {
    src: "/krakow/Florianska-Kosciol-Mariacki-M6B4280.jpg",
    alt: "Floriańska Street with St. Mary's Basilica tower framed by historic archway, Kraków Old Town",
    orientation: "vertical",
    gridArea: "img4"
  }
];
---

<Section>
  <article>
  <div class="krakow-gallery-container">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center space-y-6 mb-12">
      <Headline id="krakow" title="Discover Kraków" center={true} />

      <p class="text-lg leading-relaxed">
        Join us in the beautiful city of Kraków, where medieval architecture meets modern innovation.
        Explore the historic Old Town, stunning Wawel Castle, and vibrant riverside boulevards.
      </p>
    </div>

    <div class="bento-grid" role="region" aria-label="Gallery of Kraków city photos">
      {images.map((image, index) => (
        <div
          class={`bento-item ${image.gridArea}`}
          data-orientation={image.orientation}
        >
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="gallery-image"
          />
          <div class="image-overlay" aria-hidden="true"></div>
        </div>
      ))}
    </div>

    <div class="text-center mt-8 space-y-4">
      <p class="text-sm text-gray-500">
        📸 Photos by Ela Marchewka
      </p>
      <div class="pt-12 flex w-full justify-evenly items-center">
        <Button secondary url="/krakow">More about Krakow</Button>
        <Button secondary url="/venue">More About Venue</Button>
      </div>
    </div>
    </article>
  </div>
</Section>

<div class="city" id="one">
  <Logo />
</div>

<style>
  article {
    position: relative;
    top: 40vh;
    margin-top: -40vh;
    z-index: 10;
  }
  .city {
    position: relative;
    top: 0;
    width: 100%;
    grid-column: 1 / 4;
    overflow: hidden;
  }
  .city svg {
    width: 100vw;
    position: relative;
    bottom: -4px;
    z-index: 1;
  }

  .krakow-gallery-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto;
    gap: 1rem;
  }

  .img1 {
    grid-column: span 3;
    height: 400px;
  }

  .img2 {
    grid-column: span 1;
    height: 550px;
  }

  .img3 {
    grid-column: span 1;
    height: 550px;
  }

  .img4 {
    grid-column: span 1;
    height: 550px;
  }

  .bento-item {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .bento-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .bento-item:focus-within {
    outline: 3px solid #3b82f6;
    outline-offset: 2px;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .bento-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0) 50%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .bento-item:hover .image-overlay {
    opacity: 1;
  }

  /* Tablet responsiveness */
  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .img1 {
      grid-column: span 3;
      height: 350px;
    }

    .img2,
    .img3,
    .img4 {
      grid-column: span 1;
      height: 450px;
    }
  }

  /* Mobile responsiveness */
  @media (max-width: 640px) {
    .krakow-gallery-container {
      padding: 2rem 0.5rem;
    }

    .bento-grid {
      grid-template-columns: 1fr;
    }

    .img1 {
      grid-column: span 1;
      height: 250px;
    }

    .img2,
    .img3,
    .img4 {
      grid-column: span 1;
      height: 400px;
    }
  }

  /* Accessibility - prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bento-item,
    .gallery-image,
    .image-overlay {
      transition: none;
    }

    .bento-item:hover {
      transform: none;
    }

    .bento-item:hover .gallery-image {
      transform: none;
    }
  }
</style>
