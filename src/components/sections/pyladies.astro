---
import Section2 from "@ui/Section2.astro";
import Display from "@ui/Display.astro";
---

<Section2 id="pyladies" variant="bg-dark" className="pyladies-section">
  <div class="pyladies-bg" aria-hidden="true"></div>
  <div class="split-layout pyladies-inner">

    <div class="split-left pyladies-left">
      <Display id="pyladies" span="AT EP2026" spanColor="var(--color-pyladies, #d42027)" subtitle="Dedicated events for women and gender minorities in the Python community.">PYLADIES</Display>
      <a href="#" class="pyladies-cta">Learn more</a>
    </div>

    <ul class="event-list pyladies-events">
      <li>
        <strong>Self-Promotion Workshop — 17 July, 12:00–13:00</strong>
        Learn how to communicate your technical work effectively and build your personal brand in tech.
      </li>
      <li>
        <strong>PyLadies Lunch — 17 July, 13:00–14:00</strong>
        Community lunch following the workshop. Meet fellow PyLadies from across Europe and beyond.
      </li>
      <li>
        <strong>Open Space Sessions — 16–18 July, Various</strong>
        Drop-in conversations on diversity, inclusion, and building welcoming Python communities.
      </li>
    </ul>

  </div>
</Section2>

<style>
  .pyladies-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 60% at 10% 50%, rgba(210,30,60,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 50% 80% at 90% 20%, rgba(160,20,60,0.08) 0%, transparent 55%);
  }

  .split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    position: relative;
    z-index: 1;
  }

  .split-left {
    position: sticky;
    top: 2rem;
  }

  @media (max-width: 900px) {
  .split-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .split-left {
      position: static;
    }
  }



  .pyladies-cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 2rem;
    background: linear-gradient(to bottom, var(--color-pyladies, #d42027), var(--color-pyladies-dark, #b01a20));
    color: #fff;
    border: 1px solid var(--color-pyladies, #d42027);
    border-radius: 2px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pyladies-cta:hover {
    opacity: 0.85;
  }

  .event-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .event-list li {
    padding: 1.4rem 1.8rem 1.4rem 0;
    font-size: 1rem;
    color: var(--color-text-secondary-dark, rgba(255,255,255,0.78));
    line-height: 1.6;
    border-bottom: 1px dashed var(--color-border-dark, rgba(255,255,255,0.10));
  }

  .event-list li:last-child {
    border-bottom: none;
  }

  .event-list li strong {
    display: block;
    font-family: var(--font-heading, 'Roboto', sans-serif);
    font-weight: 800;
    font-size: 1rem;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  @media (max-width: 640px) {
</style>
