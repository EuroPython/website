---
// OpenSpacesCalendar.astro
//
// Renders Open Spaces events in a schedule-like grid.
// Fetches iCal data via EP_OPENSPACES_ICAL_URL env var.
// Also imports OpenSpaceEvent + fetchOpenSpacesEvents for detail pages.

import { fetchOpenSpacesEvents, type OpenSpaceEvent } from "@utils/openSpaces";

export interface Props {
  calendarId?: string;
  timeMin?: string;
  timeMax?: string;
  rooms?: string[];
}

const {
  rooms = ["S4(1,2,3)", "S4(4)", "S4(5)"],
} = Astro.props;

const TZ = "Europe/Warsaw";

function fmtTime(iso: string): string {
  try {
    return new Date(iso).toLocaleTimeString("en-GB", { timeZone: TZ, hour: "2-digit", minute: "2-digit" });
  } catch { return ""; }
}

function fmtDateLabel(isoDate: string): string {
  try {
    return new Date(isoDate + "T12:00:00Z").toLocaleDateString("en-GB", { timeZone: TZ, weekday: "long", day: "numeric", month: "long" });
  } catch { return isoDate; }
}


// ── Main data fetch ──

const allEvents = await fetchOpenSpacesEvents();

// Group by date and sort
const eventsByDate: Record<string, OpenSpaceEvent[]> = {};
for (const ev of allEvents) {
  if (!eventsByDate[ev.date]) eventsByDate[ev.date] = [];
  eventsByDate[ev.date].push(ev);
}
for (const d of Object.keys(eventsByDate)) {
  eventsByDate[d].sort((a, b) => a.startTime.localeCompare(b.startTime));
}

const sortedDates = Object.keys(eventsByDate).sort();

// Use the configured rooms as grid columns
const displayRooms = rooms;

function buildTimeSlots(dayEvents: OpenSpaceEvent[]) {
  const timeMap = new Map<string, Record<string, OpenSpaceEvent>>();
  for (const ev of dayEvents) {
    const label = fmtTime(ev.startISO);
    if (!timeMap.has(label)) timeMap.set(label, {});
    const slot = timeMap.get(label);
    if (slot) slot[ev.room] = ev;
  }
  const slots: Array<{ time: string; byRoom: Record<string, OpenSpaceEvent> }> = [];
  for (const [tl, br] of timeMap) slots.push({ time: tl, byRoom: br });
  slots.sort((a, b) => a.time.localeCompare(b.time));
  return slots;
}

const hasEvents = sortedDates.length > 0;
---

<div class="open-spaces-calendar">
  {hasEvents && (
    <div class="osp-styled-view">
      {sortedDates.map((date) => {
        const dayEvents = eventsByDate[date];
        const timeSlots = buildTimeSlots(dayEvents);

        return (
          <div class="osp-day">
            <h3 class="osp-day-title" id={`osp-day-${date}`}>
              <a href={`#osp-day-${date}`}>{fmtDateLabel(date)}</a>
            </h3>

            {timeSlots.length > 0 ? (
              <div class="osp-grid" style={`--osp-cols: ${displayRooms.length}`}>
                <div class="osp-grid-header">
                  <div class="osp-time-col osp-header-cell">Time (CEST)</div>
                  {displayRooms.map((room) => (
                    <div class="osp-room-col osp-header-cell">{room}</div>
                  ))}
                </div>

                {timeSlots.map((slot) => (
                  <div class="osp-grid-row">
                    <div class="osp-time-col osp-time-label">{slot.time}</div>
                    {displayRooms.map((room) => {
                      const ev = slot.byRoom[room];
                      return ev ? (
                        <div
                          class="osp-card"
                          title={ev.fullDescription || ev.title}
                        >
                          <a href={`/session/open-space/${ev.slug}`} class="osp-card-title">{ev.title}</a>
                          {ev.host && <div class="osp-card-host">{ev.host}</div>}
                        </div>
                      ) : (
                        <div class="osp-empty-cell" title={room}>
                          <span class="osp-empty-label">{room}</span>
                        </div>
                      );
                    })}
                  </div>
                ))}
              </div>
            ) : (
              <p class="osp-no-events">No open spaces booked for this day yet.</p>
            )}
          </div>
        );
      })}
    </div>
  )}

  {!hasEvents && (
    <div class="osp-empty">
      <i class="fas fa-calendar-plus"></i>
      <p>No Open Space events found. Be the first to organise one!</p>
    </div>
  )}
</div>

<style is:global>
  .open-spaces-calendar { margin: 1.5rem 0; }

  .osp-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--ep-text-muted, #888);
    font-family: "Inter Tight", system-ui, sans-serif;
  }
  .osp-empty i { font-size: 2.5rem; opacity: 0.4; }
  .osp-empty p { font-size: 1.05rem; max-width: 400px; }

  .osp-day { margin-bottom: 2.5rem; }
  .osp-day:last-child { margin-bottom: 0; }

  .osp-day-title {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ep-white, #e8e8e8);
    margin: 0 0 1rem;
  }
  .osp-day-title a { color: inherit; text-decoration: none; }
  .osp-day-title a:hover { text-decoration: underline; }
  .osp-no-events {
    font-family: "Inter Tight", system-ui, sans-serif;
    padding: 0.5rem 0;
    color: var(--ep-text-muted, #888);
    font-size: 0.9rem;
  }

  .osp-styled-view { margin-bottom: 2rem; }

  .osp-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: "Inter Tight", system-ui, sans-serif;
  }
  .osp-grid-header {
    display: grid;
    grid-template-columns: 80px repeat(var(--osp-cols, 3), 1fr);
    gap: 4px;
    margin-bottom: 2px;
  }
  .osp-grid-row {
    display: grid;
    grid-template-columns: 80px repeat(var(--osp-cols, 3), 1fr);
    gap: 4px;
  }
  .osp-header-cell {
    padding: 0.5rem 0.3rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ep-text-primary, #ccc);
    background: var(--ep-sched-room-bg, oklch(0.28 0.01 260));
    border-radius: 4px;
    text-align: center;
  }
  .osp-time-col {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0.4rem 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ep-text-muted, #888);
    text-align: right;
  }
  .osp-time-label { min-height: 80px; }

  .osp-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.6rem;
    background: var(--ep-surface-subtle, oklch(0.25 0.01 260));
    border: 1px solid var(--ep-border, oklch(0.35 0.01 260));
    border-radius: 6px;
    color: var(--ep-white, #e8e8e8);
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }
  .osp-card:hover {
    border-color: var(--ep-accent, #f59e0b);
    background: var(--ep-session-hover-bg, oklch(0.3 0.02 260)) !important;
    z-index: 10;
  }
  .osp-card-title {
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ep-white, #e8e8e8);
    text-decoration: none;
  }
  .osp-card-title:hover { text-decoration: underline; }
  .osp-card-host {
    font-size: 0.85rem;
    color: var(--ep-text-secondary, #b0b0b0);
    line-height: 1.3;
  }

  .osp-empty-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    font-size: 0.75rem;
    color: var(--ep-text-muted, #888);
    background: var(--ep-surface-faint, oklch(0.22 0.01 260 / 0.4));
    border: 1px dashed var(--ep-border, oklch(0.35 0.01 260));
    border-radius: 6px;
    min-height: 80px;
  }
  .osp-empty-label { opacity: 0.5; }

  @media (max-width: 800px) {
    .osp-grid-header { display: none; }
    .osp-grid-row {
      grid-template-columns: 70px 1fr;
      margin-bottom: 0.75rem;
    }
    .osp-time-col { min-height: auto; padding-top: 0.6rem; }
    .osp-empty-cell { display: none; }
    .osp-card { grid-column: 2 / -1; }
  }

  @media (max-width: 500px) {
    .osp-grid-row { grid-template-columns: 1fr; }
    .osp-time-col { text-align: left; padding: 0.3rem 0; justify-content: flex-start; }
    .osp-card { grid-column: 1 / -1; }
  }
</style>
