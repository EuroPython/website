---
import Keynoter from "./keynoter.astro";
import Button from "@ui/Button.astro";
import { getCollection } from "astro:content";

const allKeynoters = await getCollection("keynoters");
const keynoters = allKeynoters.sort((a, b) => a.data.order - b.data.order);

const placeholderCount = Math.max(0, 6 - keynoters.length);
const placeholders = Array.from({ length: placeholderCount }, (_, i) => ({
  name: "",
  url: "",
  order: keynoters.length + i + 1,
}));
---

<section class="sec-wrap progtalk-section" id="keynoters">
  <div class="sec-inner">

    <div class="prog-keynoters">
      <p class="prog-topics-label">Keynote Speakers</p>
      <ul class="prog-keynoters-grid">
        {keynoters.map((k) => (
          <Keynoter
            name={k.data.name}
            url={k.data.url || ""}
            tagline={k.data.tagline}
            bio={k.data.bio}
            image={k.data.image}
            order={k.data.order}
          />
        ))}
        {placeholders.map((p) => (
          <Keynoter
            name={p.name}
            url={p.url}
            order={p.order}
            placeholder={true}
          />
        ))}
      </ul>
    </div>

    <div class="prog-more">
      <a href="/sessions" class="prog-more-cta">Explore the full programme</a>
    </div>

  </div>
</section>

<style>
  .sec-wrap {
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .sec-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4.5rem 2rem;
    position: relative;
    z-index: 1;
  }

  .progtalk-section {
    background: var(--color-section-bg, #080f1a);
    scroll-margin-top: 60px;
  }

  .prog-keynoters {
    margin-top: 0;
  }

  .prog-topics-label {
    font-family: var(--font-archivo, 'Archivo Black', sans-serif);
    font-size: 1.4rem;
    color: var(--color-cream, #fff5f0);
    margin-bottom: 1.2rem;
    text-align: center;
  }

  .prog-keynoters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 1.5rem;
  }

  .prog-more {
    text-align: center;
    margin-top: 3rem;
  }

  .prog-more-cta {
    display: inline-block;
    padding: 0.85rem 2.5rem;
    background: var(--color-cta-red, #d4003a);
    color: #fff;
    border: 1px solid var(--color-cta-red, #d4003a);
    border-radius: 0.375rem;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .prog-more-cta:hover {
    opacity: 0.85;
  }

  @media (max-width: 1024px) {
    .prog-keynoters-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .prog-keynoters-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
