---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  name: string;
  url: string;
  tagline?: string | undefined;
  bio?: string | undefined;
  image?: ImageMetadata;
  placeholder?: boolean | undefined;
  order: number;
  class?: string;
}

const {
  name,
  url,
  tagline,
  bio,
  image,
  placeholder,
  class: className,
} = Astro.props;
---

<li class:list={["prog-keynoter", className]}>
  {
    placeholder ? (
      <div class="prog-keynoter-link">
        <div class="prog-keynoter-photo">
          <div class="prog-keynoter-photo--empty">
            <span class="prog-keynoter-placeholder">?</span>
          </div>
        </div>
      </div>
    ) : !image ? (
      url ? (
        <a href={`/speaker/${url}/`} class="prog-keynoter-link">
          <div class="prog-keynoter-photo">
            <div class="prog-keynoter-photo--light" />
          </div>
          <div class="prog-keynoter-body">
            <div class="prog-keynoter-name">{name}</div>
            {tagline && <div class="prog-keynoter-role">{tagline}</div>}
            {bio && <p class="prog-keynoter-bio">{bio}</p>}
          </div>
        </a>
      ) : (
        <div class="prog-keynoter-link">
          <div class="prog-keynoter-photo">
            <div class="prog-keynoter-photo--light" />
          </div>
          <div class="prog-keynoter-body">
            <div class="prog-keynoter-name">{name}</div>
            {tagline && <div class="prog-keynoter-role">{tagline}</div>}
            {bio && <p class="prog-keynoter-bio">{bio}</p>}
          </div>
        </div>
      )
    ) : url ? (
      <a href={`/speaker/${url}/`} class="prog-keynoter-link">
        <div class="prog-keynoter-photo">
          {image ? (
            <>
              <Image src={image} alt={name} class="prog-keynoter-img" />
            </>
          ) : (
            <div class="prog-keynoter-photo--empty">
              <span class="prog-keynoter-placeholder">?</span>
            </div>
          )}
        </div>
        <div class="prog-keynoter-body">
          <div class="prog-keynoter-name">{name}</div>
          {tagline && <div class="prog-keynoter-role">{tagline}</div>}
          {bio && <p class="prog-keynoter-bio">{bio}</p>}
        </div>
      </a>
    ) : (
      <div class="prog-keynoter-link">
        <div class="prog-keynoter-photo">
          {image ? (
            <>
              <Image src={image} alt={name} class="prog-keynoter-img" />
            </>
          ) : (
            <div class="prog-keynoter-photo--empty">
              <span class="prog-keynoter-placeholder">?</span>
            </div>
          )}
        </div>
        <div class="prog-keynoter-body">
          <div class="prog-keynoter-name">{name}</div>
          {tagline && <div class="prog-keynoter-role">{tagline}</div>}
          {bio && <p class="prog-keynoter-bio">{bio}</p>}
        </div>
      </div>
    )
  }
</li>

<style>
  .prog-keynoter {
    border-right: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    overflow: hidden;
    transition: background 0.2s;
    list-style: none;
  }

  .prog-keynoter:nth-child(3n) {
    border-right: none;
  }

  .prog-keynoter:nth-last-child(-n + 3) {
    border-bottom: none;
  }

  .prog-keynoter:hover {
    background: var(--color-surface-subtle);
  }

  .prog-keynoter-link {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    height: 100%;
  }

  .prog-keynoter-photo {
    width: 100%;
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .prog-keynoter-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .prog-keynoter:hover .prog-keynoter-img {
    transform: scale(1.05);
  }

  .prog-keynoter-photo--empty {
    width: 100%;
    height: 100%;
    background: var(--color-section-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prog-keynoter-placeholder {
    font-size: 5rem;
    opacity: 0.12;
    color: var(--color-white);
  }

  .prog-keynoter-photo--light {
    width: 100%;
    height: 100%;
    background: var(--color-surface-medium);
  }

  .prog-keynoter-body {
    padding: 1.8rem 1.8rem 2rem;
  }

  .prog-keynoter-name {
    font-size: 1.3rem;
    color: var(--color-text);
    margin-bottom: 0.3rem;
    line-height: 1.2;
  }

  .prog-keynoter-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent-themed);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.8rem;
  }

  .prog-keynoter-bio {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .prog-keynoter:nth-child(2n) {
      border-right: none;
    }
  }

  @media (max-width: 640px) {
    .prog-keynoter {
      border-right: none !important;
      border-bottom: 1px dashed var(--color-border);
    }
    .prog-keynoter:last-child {
      border-bottom: none;
    }
  }
</style>
