---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Section2 from "@ui/Section2.astro";
import Title from "@ui/Title.astro";

const allSpeakers = await getCollection("speakers");
const validSpeakers = allSpeakers.filter(s => !!s.data?.name && !!s.data?.avatar);

const featuredSpeakers = validSpeakers.sort(() => 0.5 - Math.random()).slice(0, 6);
const sectionTitle = "Featured Speakers";
const sectionSubtitle = "Meet some of our amazing speakers";
---

<Section2 id="speakers" variant="dark">
  <div class="section-header">
    <Title id="speakers" subtitle={sectionSubtitle}>{sectionTitle}</Title>
  </div>

  <div class="speakers-grid">
    {featuredSpeakers.map((speaker) => (
      <a href={`/speaker/${speaker.id}`} class="speaker-card">
        <div class="speaker-photo">
          <Image
            src={speaker.data.avatar}
            alt={speaker.data.name}
            class="speaker-img"
            height={300}
            width={300}
            loading="lazy"
          />
        </div>
        <div class="speaker-info">
          <h3 class="speaker-name">{speaker.data.name}</h3>
        </div>
      </a>
    ))}
  </div>

  <div class="speakers-footer">
    <a href="/speakers" class="speakers-cta">See all speakers</a>
  </div>
</Section2>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }

  .speaker-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px dashed var(--color-border-dark, rgba(255,255,255,0.10));
    border-radius: 2px;
    overflow: hidden;
    transition: border-color 0.3s var(--ease-premium, cubic-bezier(0.32, 0.72, 0, 1)),
                transform 0.3s var(--ease-premium, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .speaker-card:hover {
    border-color: var(--color-accent, #f0c040);
    transform: translateY(-4px);
  }

  .speaker-photo {
    aspect-ratio: 1/1;
    overflow: hidden;
  }

  .speaker-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease-premium, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .speaker-card:hover .speaker-img {
    transform: scale(1.05);
  }

  .speaker-info {
    padding: 0.6rem 0.8rem;
    text-align: center;
  }

  .speaker-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary-dark, rgba(255,255,255,0.93));
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .speakers-footer {
    text-align: center;
    margin-top: 2.5rem;
  }

  .speakers-cta {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-accent, #f0c040);
    color: var(--color-section-bg, #080f1a);
    border: 1px solid var(--color-accent, #f0c040);
    border-radius: 2px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.35s var(--ease-premium, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .speakers-cta:active { transform: scale(0.97); }
  .speakers-cta:hover { filter: brightness(1.1); }

  @media (max-width: 1024px) {
    .speakers-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .speakers-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
