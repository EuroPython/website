---
import Button from "@ui/Button.astro";
---

<section class="hero-main">
  <div class="hero-flowers-bg" aria-hidden="true"></div>
  <div class="hero-container">
    <div class="hero-content-block">
      <!-- <img src="/25yr.svg" alt="This Summer. 25 Years." class="hero-tagline-img"> -->
      <h1 class="hero-heading">EURO<br>PYTHON</h1>
      <div class="hero-year">2026</div>
      <p class="hero-intro">A week of talks, tutorials, sprints, and community. Join 1500+ Pythonistas in July,<br> in <a href="#krakow">Kraków, Poland 🇵🇱</a>.</p>
      <p class="hero-schedule"><span>Tutorials</span> 13–14 July &nbsp;|&nbsp; <span>Conference</span> 15–17 July <br><span>Sprints</span> 18–19 July &nbsp;|&nbsp; <a href="#euroscipy">EuroSciPy</a> 18–23 July</p>
      <div class="hero-cta-row">
        <a href="/tickets" class="hero-cta">Register Now</a>
        <a href="#programme" class="hero-cta-alt">View Programme</a>
      </div>
    </div>
    <div class="hero-dragon">
      <img src="/dragon.svg" alt="" class="dragon-svg" loading="lazy">
    </div>
  </div>
</section>

<style>
  .hero-main {
    position: relative;
    min-height: 100vh;
    background-color: #080f1a;
    display: flex;
    align-items: center;
    padding: 6rem 2rem;
  }

  .hero-flowers-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.04;
    filter: brightness(1.5) saturate(0.3);
    background: url('/flowers/flowers-tile.svg') repeat;
    background-size: 2400px 2400px;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .hero-dragon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
  }

  .dragon-svg {
    width: 100%;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
    }
    .hero-dragon {
      display: none;
    }
  }

  .hero-content-block {
    max-width: 600px;
  }

  .hero-tagline-img {
    display: block;
    width: clamp(12rem, 15vw, 20rem);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .hero-heading {
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.85;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hero-year {
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: clamp(6rem, 12vw, 12rem);
    line-height: 0.82;
    letter-spacing: -0.08em;
    background: radial-gradient(ellipse at top left, var(--color-cta-red, #d62020) 0%, #a8002d 55%, #700020 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-top: 0.3rem;
  }

  .hero-intro {
    font-family: var(--font-dm-sans, 'DM Sans', system-ui, sans-serif);
    font-size: 1.3rem;
    color: var(--color-text-secondary-dark, rgba(255,255,255,0.78));
    margin-top: 2rem;
    line-height: 1.6;
    max-width: 440px;
  }

  .hero-intro a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-schedule {
    margin-top: 1.5rem;
    font-family: var(--font-dm-sans, 'DM Sans', system-ui, sans-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.03em;
  }

  .hero-schedule span {
    color: var(--color-accent, #f0c040);
    font-weight: 700;
  }

  .hero-schedule a {
    color: var(--color-accent, #f0c040);
    font-weight: 700;
    text-decoration: none;
  }

  .hero-cta-row {
    margin-top: 5.5rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-cta {
    font-family: var(--font-archivo, 'Roboto', sans-serif);
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: none;
    border: 3px solid var(--color-cta-red, #d62020);
    border-radius: 2px;
    padding: 1rem 2.5rem;
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
    box-shadow: 0 0 20px rgba(214,32,32,0.3), inset 0 0 20px rgba(214,32,32,0.05);
  }

  .hero-cta:hover {
    background: var(--color-cta-red, #d62020);
    color: #fff;
    box-shadow: 0 0 50px rgba(214,32,32,0.6), inset 0 0 25px rgba(214,32,32,0.15);
  }

  .hero-cta-alt {
    font-family: var(--font-dm-sans, 'DM Sans', system-ui, sans-serif);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent, #f0c040);
    border: 3px solid var(--color-accent, #f0c040);
    border-radius: 2px;
    padding: 0.9rem 2rem;
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
    box-shadow: 0 0 16px rgba(240,192,64,0.2), inset 0 0 16px rgba(240,192,64,0.04);
  }

  .hero-cta-alt:hover {
    background: var(--color-accent, #f0c040);
    color: var(--color-section-bg, #080f1a);
    box-shadow: 0 0 40px rgba(240,192,64,0.5), inset 0 0 20px rgba(240,192,64,0.1);
  }

  @media (max-width: 768px) {
    .hero-main {
      padding: 5rem 1.2rem 3rem;
      min-height: auto;
    }
    .hero-content-block {
      max-width: 100%;
    }
    .hero-schedule {
      font-size: 1rem;
    }
    .hero-tagline-img {
      width: 140px;
      margin-bottom: 1rem;
    }
  }
</style>
