---
import Icon from "@ui/Icon.astro";
import links from "@data/links.json";
import EPSLogo from "../../public/eps-logo.svg";

const buildTimestamp = __TIMESTAMP__;
const gitVersion = __GIT_VERSION__;

const socialLinks = [
  { key: "website", icon: "globe", label: "Website" },
  { key: "blog", icon: "rss", label: "Blog" },
  { key: "linkedin", icon: "linkedin", label: "LinkedIn" },
  { key: "github", icon: "github", label: "GitHub" },
  { key: "mastodon", icon: "mastodon", label: "Mastodon" },
  { key: "bluesky", icon: "bluesky", label: "Bluesky" },
  { key: "twitter", icon: "x-twitter", label: "Twitter" },
  { key: "instagram", icon: "instagram", label: "Instagram" },
  { key: "youtube", icon: "youtube", label: "YouTube" }
];

---

  <div
    class="text-white max-w-4xl lg:max-w-6xl mx-auto py-10 px-6"
  >
  <p class="mb-16 text-white/10" >
          version: {gitVersion} @ {buildTimestamp}
          </p>
    <div class="links flex flex-wrap gap-8 justify-around">
      {
        links.footer.map((section) => (
        <div class="md:w-auto mb-8 md:mb-0 text-start">
            <h3 class="font-bold text-lg mb-4">{section.name}</h3>
            {section.items ? (
              <ul class="space-y-2">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.path}
                      class="text-gray-700 hover:text-primary-hover transition-colors duration-200"
                    >
                      {item.name}
                      {item.path.startsWith("http") && (
                        <span class="inline-block ml-1">↗</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <a
                href={section.path}
                class="text-gray-700 hover:text-primary-hover transition-colors duration-200"
              >
                {section.name}
                {section.path?.startsWith("http") && (
                  <span class="inline-block ml-1">↗</span>
                )}
              </a>
            )}
          </div>
        ))
      }

      <div class="w-full py-2 border-t border-b border-white/10">
    <div
      class="flex flex-col lg:flex-row self-center gap-8 lg:gap-12 justify-end"
    >
    <div class="flex flex-col text-white/40  w-full lg:w-2/3 px-6 items-center">
        <p>Excited about our mission? Want to collaborate or contribute? Let's connect!
We're open to partnership opportunities and would love to hear your ideas.
<a class="text-white" href="mailto:helpdesk@europython.eu">helpdesk@europython.eu</a>
</p>
        <div class="social-links flex justify-center space-x-4 pt-4">
          {socialLinks
            .filter((link) => links.socials?.[link.key])
            .map((link) => {
              if (!links.socials) return;
              const url = links.socials[link.key];
              let iconColor:string;

              switch(link.key) {
                case "facebook":
                  iconColor = "facebook";
                  break;
                case "twitter":
                  iconColor = "twitter";
                  break;
                case "linkedin":
                  iconColor = "linkedin";
                  break;
                case "github":
                  iconColor = "github";
                  break;
                case "instagram":
                  iconColor = "instagram";
                  break;
                case "discord":
                  iconColor = "discord";
                  break;
                case "mastodon":
                  iconColor = "mastodon";
                  break;
                case "bluesky":
                  iconColor = "bluesky";
                  break;
                default:
                  iconColor = "";
                  break;
              }

              return (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.label}
                  class={`social-icon ${iconColor}`}
                >
                  <span class="social-icon-inner">
                    <Icon name={link.icon} style="brands" size="fa-lg" />
                  </span>
                </a>
              );
            })}
        </div>

      </div>
      <div class="flex text-white/40 w-full lg:w-1/3 text-start">
        <div>
          <EPSLogo width=90 height=90 class="w-[90px] mr-4 h-auto " />
        </div>
        <div>
          <address class="not-italic ">
            EuroPython Society (EPS)
            <br />Ramnebacken 45
            <br />
            424 38 Agnesberg
            <br />
            Sweden
          </address>
        </div>
        </div>
      </div>
    </div>
    <div class=" terms flex flex-row justify-around w-1/3">
          {links.terms.map((item) => (
              <a
                href={item.path}
                class="text-gray-700 hover:text-primary-hover transition-colors duration-200"
              >
                {item.name}
                {item.path.startsWith("http") && (
                  <span class="inline-block ml-1">↗</span>
                )}
              </a>
          ))}
      </div>
  </div>
<style>
  .links > div:first-child {
    font-size: 1.8rem;
  }
  .terms {
    font-size: 0.8rem;
    opacity:0.4;
  }
</style>
