---
import { getEntries, type CollectionEntry } from "astro:content";

const { entry, session } = Astro.props;

// If a specific session is passed use it, otherwise fall back to all (legacy)
const sessions: CollectionEntry<"sessions">[] = session
  ? [session]
  : await getEntries(entry.data.submissions);
---
<svg class="bg" width="900" height="900" class="h-full w-full -z-10">
  <image href="/social/speaker_card.png" width="900" height="900" />
</svg>
{
  entry.data.avatar ? (
    <svg class="avatar" width="900" height="900">
      <defs>
        <clipPath id="curvedCornerClip">
          <circle cx="645" cy="645" r="230" />
        </clipPath>
      </defs>
      <image
        href={entry.data.avatar}
        x="415"
        y="415"
        width="460"
        height="460"
        clip-path="url(#curvedCornerClip)"
        preserveAspectRatio="xMidYMid slice"
      />
    </svg>
<p
  class="box fit-text"
>
{sessions.map((session) => <>{session.data.title}</>)}
</p>

<p lang="en" class="box2 fit-text" data-max-font="60">
  {entry.data.name}
</p>

):(

<p
  class="box3 fit-text"
>
{sessions.map((session) => <>{session.data.title}</>)}
</p>

<p lang="en" class="box4 fit-text">
  {entry.data.name}
</p>

)
}



<style>
  /* With avatar: text occupies the left ~half of the card */
  .box {
      position: absolute;
      left: 0;
      top: 200px;
      width: 450px;
      height: 320px;
      font-size: 100px;
      color: rgb(239, 215, 123);
      padding: 1rem;
  }

  .box2 {
      position: absolute;
      left: 0;
      top: 540px;
      width: 450px;
      height: 160px;
      font-size: 70px;
      color: white;
      padding: 1rem 3rem;
  }

  /* No avatar: text spans the full width */
  .box3 {
      position: absolute;
      left: 0;
      top: 220px;
      width: 900px;
      height: 320px;
      font-size: 100px;
      color: rgb(239, 215, 123);
      padding: 1rem;
  }

  .box4 {
      position: absolute;
      left: 0;
      top: 540px;
      width: 900px;
      height: 200px;
      font-size: 70px;
      color: white;
      padding: 1rem;
  }

  .box, .box2, .box3, .box4 {
      box-sizing: border-box;
      overflow: hidden;
      display: block;
      text-align: center;
      font-family: Inter, sans-serif !important;
      font-weight: bold;
      line-height: 1.1em;
  }
</style>
