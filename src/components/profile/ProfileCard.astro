---
const {name, slug, url, avatar, company, position=""} = Astro.props;
const defaultAltText = `Profile photo of ${name}`;

const link = url? url:`/speaker/${slug}`
const isExternal = Boolean(url);
---

<a
  href={link}
  class=`hover:scale-105 transition-transform  ${isExternal && "external"}`
  target=`${isExternal && "_blank"}`
>
<div class=`profile-card`>
    <img
      src={avatar}
      alt={defaultAltText}
      class="profile-image"
    />
    <span class="profile-text">{name}</span>
    {position && <span class="text-sm">{position}</span>}
    {company && <span class="text-sm">@ {company}</span>}
  </div>
</a>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }


  a.external .profile-text::after {
    font-size: 0.8em;
    content: " ↗";
  }


  .profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .profile-image {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
    margin:0;
    border-width: 4px;
    border-color: white;
    border-style: solid;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .profile-text {
    padding-top:10px;
    text-align: center;
    width: 100%;
  }


</style>
