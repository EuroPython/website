---
import Icon from "@ui/Icon.astro";

export interface Props {
  title: string;
  icon: string;
}

const { icon, title: label } = Astro.props;
---

<div
  class="flex items-center gap-2 text-xl font-semibold"
  role="group"
  aria-label={label}
>
  <Icon name={icon} class="mr-1" />
  <span>{label}</span>
</div>
