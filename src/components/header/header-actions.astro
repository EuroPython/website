---
import Button from "@ui/Button.astro";
import Icon from "@ui/Icon.astro";
import ThemeToggle from "@components/ThemeToggle.astro";

export interface Props {
  mobile?: boolean;
}

const { mobile = false }: Props = Astro.props;

const IS_LIVE = false;

---

<div class="flex items-center justify-end gap-2 w-1/3">
<div class="ml-auto justify-end flex items-center w-full">
  {
    !mobile ?
      <>

        <ThemeToggle />
          <button
            id="searchButton"
          class="mx-6 md:mx-2"
            data-open-modal="modal-search"
            aria-label="Search"
            aria-keyshortcuts="Control+K"
          >
            <Icon name="search" />
            <span class="hidden md:block" aria-hidden="true">Search</span>
            <kbd class="hidden md:flex" >
              <kbd>Ctrl</kbd><kbd>K</kbd>
            </kbd>
          </button>
      {IS_LIVE && <Button url="/live">Live</Button>}
      </>
     : null
  }

  <label for="nav_toggle" class="flex xl:hidden" aria-label="Toggle navigation menu">
      <span class="w-[3em] h-[3em] font-bold text-lg px-4 py-4 rounded-full inline-flex items-center justify-center leading-4 transition-colors duration-200 not-prose border hover:text-black bg-primary text-white hover:bg-primary-hover border-transparent">
      {mobile ? <Icon name="close" size="fa-xl" /> : <Icon name="bars" size="fa-xl" />}
      </span>
  </label>
</div>

<style>
	button[data-open-modal] {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 0;
		background-color: transparent;
    color: oklch(0.6 0 0); /* grey */
		cursor: pointer;
		height: 2.5rem;
		font-size: 28px;
	}

	@media (min-width: 45rem) {
		button[data-open-modal] {
			border: 1px solid oklch(0.845 0 0); /* #ccc */
			border-radius: 0.5rem;
			padding-inline-start: 0.75rem;
			padding-inline-end: 0.5rem;
			background-color: var(--color-white);
			font-size: 16px;
      width:100%;
			min-width: 10rem;
			max-width: 22rem;
			color: oklch(0.392 0.068 63.4); /* #5f3d1b */
		}
		button[data-open-modal]:hover {
			border-color: oklch(0.392 0.068 63.4); /* #5f3d1b */
      color: var(--color-black);
		}

		button[data-open-modal] > :last-child {
			margin-inline-start: auto;
		}
	}

	button > kbd {
		border-radius: 0.25rem;
			font-size: 16px;
		gap: 0.25em;
		padding-inline: 0.375rem;
		background-color: oklch(0.919 0.025 61.6); /* #F1E1D4 */
    color: oklch(0.392 0.068 63.4); /* #5f3d1b */
	}

	kbd {
		font-family: var(--__sl-font);
	}

	button[data-close-modal] {
		position: absolute;
		z-index: 1;
		align-items: center;
		align-self: flex-end;
		height: calc(64px * var(--pagefind-ui-scale));
		padding: 0.25rem;
		border: 0;
		background: transparent;
		cursor: pointer;
		color: oklch(0.321 0 0); /* #333 */
	}
</style>
