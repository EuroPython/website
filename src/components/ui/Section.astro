---
const { full = false, variant = "default", padding = true } = Astro.props;

const variantClass =
  {
    default: "",
    primary: "bg-[#E8F4F8]",
    secondary: "bg-white",
  }[variant] || "";
---

<section class=`${variantClass} ${padding && "py-6"}`>
  {
    full ? (
      <slot />
    ) : (
      <div class="container">
        <slot />
      </div>
    )
  }
</section>

<style>
  .container {
    margin-left: auto;
    margin-right: auto;
    padding-left: 0.5rem; /* px-2 = 0.5rem */
    padding-right: 0.5rem;
  }

  @media (min-width: 768px) {
    .container {
      padding-left: 1.25rem; /* md:px-5 = 1.25rem */
      padding-right: 1.25rem;
    }
  }
</style>
