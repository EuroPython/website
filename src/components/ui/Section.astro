---
const { full = false, variant = "default", id, class: className = "" } = Astro.props;

const variantClass = {
  default: "",
  primary: "bg-[#E8F4F8]",
  secondary: "bg-white",
  dark: "bg-section-bg",
  "dark-alt": "bg-section-bg-alt",
  "bg-dark": "bg-bg-dark",
}[variant] || "";

const wrapClass = full ? "" : "sec-inner";
---

<section class=`sec-wrap ${variantClass} ${className}` id={id}>
  <div class={wrapClass}>
    <slot />
  </div>
</section>

<style>
  .sec-wrap {
    position: relative;
  }

  .sec-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.55rem 0;
    position: relative;
    z-index: 1;
  }
</style>
