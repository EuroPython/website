---
const {
  name,
  svg = false,
  style = "solid",
  class: className = "",
  size = "", // Default size (Tailwind)
  label = "",
  role = "img",
} = Astro.props;
---

{
  svg ? (
    <svg
      class={`${size} ${className}`}
      aria-label={label || undefined}
      role={label ? role : "presentation"}
      aria-hidden={!label}
    >
      <use href={`#${name}`} />
    </svg>
  ) : (
    <i
      class={`fa-${style} fa-${name} ${size} ${className}`}
      aria-label={label || undefined}
      role={label ? role : "presentation"}
      aria-hidden={!label}
    />
  )
}
