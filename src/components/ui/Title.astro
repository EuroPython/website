---
function highlightTitle(
  text: string,
  highlight?: string,
  color?: string,
): string {
  if (!highlight) return text;
  const idx = text.toUpperCase().indexOf(highlight.toUpperCase());
  if (idx === -1) return text;
  const before = text.slice(0, idx).trimEnd();
  const match = text.slice(idx, idx + highlight.length);
  const after = text.slice(idx + highlight.length);
  if (!before) {
    // Highlight at start — put br after the highlight
    return `<span style="color: ${color || "var(--color-accent)"}">${match}</span><br>${after.trimStart()}`;
  }
  // Highlight not at start — put br before the highlight
  return `${before}<br><span style="color: ${color || "var(--color-accent)"}">${match}</span>${after}`;
}

export interface Props {
  id: string;
  subtitle?: string;
  color?: string; // title text color, default #fff
  anchorColor?: string; // anchor link color, default matches color
  title?: string; // optional title text (overrides slot)
  highlight?: string; // word to color differently
  highlightColor?: string; // color for highlighted word
}

const {
  id,
  subtitle,
  color = "var(--color-text)",
  anchorColor = color,
  title: titleText,
  highlight,
  highlightColor,
} = Astro.props;

const rendered = titleText
  ? highlightTitle(titleText, highlight, highlightColor)
  : null;
---

<h2 class="sec-title" style={`color: ${color}`}>
  {rendered ? <Fragment set:html={rendered} /> : <slot />}
  <sup class="sec-anchor"
    ><a
      href={`#${id}`}
      style={`color: ${anchorColor}`}
      aria-label={`Jump to ${id}`}>#</a
    ></sup
  >
</h2>
{
  subtitle && (
    <p class="sec-subtitle" style={`color: var(--color-text-muted)`}>
      {subtitle}
    </p>
  )
}

<style>
  .sec-title {
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    position: relative;
  }

  .sec-title .sec-anchor {
    position: absolute;
    margin-left: 0.2em;
    margin-top: 2rem;
    font-size: 0.5em;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .sec-title:hover .sec-anchor {
    opacity: 0.5;
  }

  .sec-anchor a {
    text-decoration: none;
  }

  .sec-subtitle {
    font-size: 1.1rem;
    line-height: 1.55;
    max-width: 600px;
    margin: 1.2rem auto 0;
  }
</style>
