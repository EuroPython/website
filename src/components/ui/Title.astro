---
export interface Props {
  id: string;
  subtitle?: string;
  color?: string; // title text color, default #fff
  anchorColor?: string; // anchor link color, default matches color
  as?: "h1" | "h2"; // h1 when the Title is the page's main heading
}

const {
  id,
  subtitle,
  color = "var(--color-text)",
  anchorColor = color,
  as: Tag = "h2",
} = Astro.props;
---

<Tag class="sec-title" style={`color: ${color}`}>
  <slot />
  <sup class="sec-anchor"
    ><a
      href={`#${id}`}
      style={`color: ${anchorColor}`}
      aria-label={`Jump to ${id}`}>#</a
    ></sup
  >
</Tag>
{
  subtitle && (
    <p class="sec-subtitle" style={`color: var(--color-text-muted)`}>
      {subtitle}
    </p>
  )
}

<style>
  .sec-title {
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    position: relative;
  }

  .sec-title .sec-anchor {
    position: absolute;
    margin-left: 0.2em;
    margin-top: 2rem;
    font-size: 0.5em;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .sec-title:hover .sec-anchor {
    opacity: 0.5;
  }

  .sec-anchor a {
    text-decoration: none;
  }

  .sec-subtitle {
    font-size: 1.1rem;
    line-height: 1.55;
    max-width: 600px;
    margin: 1.2rem auto 0;
  }
</style>
