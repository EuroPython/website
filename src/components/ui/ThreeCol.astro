---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-1 md:grid-cols-3 gap-4 not-prose my-6",
    className,
  ]}
>
  <slot />
</div>

<style>
  .grid > :global(.col) {
    padding: 1.6rem;
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .grid > :global(.col strong:first-child) {
    display: block;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
</style>
