---
import { getEntry } from "astro:content";
import Markdown from "@ui/Markdown.astro";
const { job:jobId, sponsor:sponsorId } = Astro.props;

const job = await getEntry("jobs", jobId);
if (!job) {
  throw new Error(`Job with ID "${jobId}" not found`);
}

const sponsor = await getEntry("sponsors", sponsorId);

if (!sponsor) {
  throw new Error(`Sponsor with ID "${sponsorId}" not found`);
}

// TODO: add tags
const { title, location, type, level, salary, description, responsibilities, min_requirements, requirements, preferred, benefits, apply_link, draft } = job.data;

---

<div class="mb-6 rounded-lg border border-white/10 bg-white/5">
  <div class=`flex-1 p-6 ${draft ? "draft": ""}`>
    <p class="text-xl pb-2 inline-block font-bold">
      {sponsor.data.name}
    </p>
    <a href={`/sponsor/${jobId}`}>
      <h2 class="text-3xl font-bold mb-2">{title}</h2>
    </a>

    <p class="text-white/60 mb-2">{([level, type, location].filter(Boolean)).join(" • ")}</p>
    <p class="text-white/70 mb-4">{salary}</p>
    <Markdown content={description || ""} class="job-post" />

    { responsibilities &&
      <h3 class="text-xl font-semibold mb-2">Responsibilities</h3>
      <ul class="list-disc list-inside mb-4">
        {responsibilities.map((item) => {
          if (typeof item === "string") {
            return <li><Markdown content={item} /></li>;
          }
          const category = Object.keys(item)[0];
          const subItems = item[category];
          return (
            <li>
              <strong>{category}</strong>
              <ul class="list-disc list-inside">
                {subItems.map((sub) => <li><Markdown content={sub} /></li>)}
              </ul>
            </li>
          );
        })}
      </ul>
    }

    { min_requirements &&
    <h3 class="text-xl font-semibold mb-2">Minimum requirements</h3>
    <ul class="list-disc list-inside mb-4">
      {min_requirements.map((item:string) => <li><Markdown content={item} /></li>)}
    </ul>
    }
    { requirements &&
    <h3 class="text-xl font-semibold mb-2">Requirements</h3>
    <ul class="list-disc list-inside mb-4">
      {requirements.map((item:string) => <li><Markdown content={item} /></li>)}
    </ul>
    }

    { preferred &&
    <h3 class="text-xl font-semibold mb-2">Nice-to-Haves</h3>
    <ul class="list-disc list-inside mb-4">
      {preferred.map((item:string) => <li><Markdown content={item} /></li>)}
    </ul>
    }

    { benefits &&
    <h3 class="text-xl font-semibold mb-2">Benefits</h3>
    <ul class="list-disc list-inside mb-6">
      {benefits.map((item:string) => <li><Markdown content={item} /></li>)}
    </ul>
    }

    { job.data.description2 &&
      <Markdown content={job.data.description2 || ""} class="job-post" />
    }

      <a
        href={apply_link}
        target="_blank"
        class="apply-btn"
>
        Apply Now
      </a>
  </div>
</div>

<style>

  .apply-btn {
    display: inline-block;
    padding: 8px 24px;
    color: white;
    font-weight: 700;
    border-radius: 9999px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.1s ease;
    background: linear-gradient(to right, oklch(0.627 0.17 149.2) /* #16a34a */, oklch(0.723 0.192 149.6) /* #22c55e */);
  }

  .apply-btn:hover {
    color:white;
  }

  a{
    text-decoration: underline;
  }
  a:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

</style>
