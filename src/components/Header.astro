---
import HeaderLogo from "@components/header/header-logo.astro";
import Search from "@components/Search.astro";
import ThemeToggle from "@components/ThemeToggle.astro";

import { NAV_MENUS } from "@data/nav";
import { buildLinkChecker } from "@utils/nav";

const linkExists = await buildLinkChecker();

// Filter nav menus to only show links that point to existing pages
const activeMenus = NAV_MENUS.map((menu) => ({
  ...menu,
  sections: menu.sections
    ?.map((section) => ({
      ...section,
      items: section.items.filter((item) => linkExists(item.url)),
    }))
    .filter((section) => section.items.length > 0),
})).filter((menu) => !menu.sections || menu.sections.length > 0);

// ── Layout constants (matching CSS) ──
---

<nav aria-label="Main navigation" id="navbar">
  <HeaderLogo />

  <!-- ─── Nav links (triggers + mega dropdown) ─── -->
  <ul class="nav-links" id="nav-links-menu">
    <li class="nav-item nav-mobile-search" id="nav-mobile-search">
      <button type="button" class="nav-mobile-search-btn" aria-label="Search">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="8"></circle><line
            x1="21"
            y1="21"
            x2="16.65"
            y2="16.65"></line></svg
        >
        Search
      </button>
    </li>
    {
      activeMenus
        .filter((m) => m.label !== "Jobs")
        .map((menu) =>
          menu.sections ? (
            <li class="nav-item has-dropdown">
              <button
                class="nav-link-btn mn-trigger"
                data-nav-id={menu.label.replace(/\s+/g, "-").toLowerCase()}
                aria-haspopup="true"
                aria-expanded="false"
              >
                {menu.label}
                <span class="nav-arrow" aria-hidden="true">
                  ▾
                </span>
              </button>
              <div class="mn-mobile-sub">
                <div class="mn-inner">
                  {menu.sections!.map((section) => (
                    <div
                      class="mn-group"
                      class:list={{ "mn-group-full": !section.label }}
                    >
                      {section.label && (
                        <p class="mn-section-label">{section.label}</p>
                      )}
                      <ul class="mn-items" role="list">
                        {section.items.map((item) => (
                          <li role="none">
                            <a
                              href={item.url}
                              class="mn-link"
                              target={item.external ? "_blank" : undefined}
                              rel={
                                item.external ? "nofollow noopener" : undefined
                              }
                            >
                              <span
                                class="mn-link-label"
                                set:html={item.label}
                              />
                              {item.external && (
                                <span class="nav-ext">&#8599;</span>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          ) : (
            <li class="nav-item">
              <a class="nav-link-btn" href={menu.url || "#"}>
                {menu.label}
              </a>
            </li>
          ),
        )
    }
    <li class="nav-item nav-mobile-cta">
      <a class="nav-link-btn" href="/jobs">Jobs</a>
    </li>
    <li class="nav-item nav-mobile-cta">
      <a class="nav-link-btn" href="/tickets">Register Now</a>
    </li>
  </ul>

  <button
    class="nav-icon-btn"
    id="nav-search-btn"
    aria-label="Search"
    data-open-modal="modal-search"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </button>
  <a
    href="/discord"
    class="nav-icon-btn"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Discord"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"
      ></path>
    </svg>
  </a>
  <ThemeToggle />
  <a href="/jobs" class="nav-cta-desktop">Jobs</a>
  <a href="/tickets" class="nav-cta">Register Now</a>
  <button
    class="nav-toggle"
    aria-label="Toggle menu"
    aria-expanded="false"
    aria-controls="nav-links-menu"
  >
    <span></span><span></span><span></span>
  </button>
</nav>

<Search />

<style>
  /* ═══════════════════════════════════════════
     EXISTING HEADER STYLES (unchanged)
     ═══════════════════════════════════════════ */

  nav {
    position: fixed;
    top: 40px;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: oklch(0.155 0.034 281.7 / 0.95);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--color-surface-medium);
    padding: 0.55rem calc((100% - 1200px) / 2);
    white-space: nowrap;
    box-shadow: 0 2px 20px oklch(0 0 0 / 0.05);
    transition:
      transform 0.3s ease-in-out,
      top 0.3s ease;
    transform: translateY(0);
  }

  .nav-links {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .nav-item {
    position: relative;
  }

  .nav-link-btn {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.55rem 1.1rem;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    border-radius: 2px;
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-link-btn:hover,
  .nav-link-btn:focus-visible {
    color: var(--color-accent-themed);
    text-decoration-color: var(--color-accent-themed);
    outline: none;
  }

  .nav-arrow {
    font-size: 0.55em;
    opacity: 0.6;
    transition: transform 0.2s;
    display: inline-block;
  }
  .mn-trigger-active .nav-arrow {
    transform: rotate(180deg);
  }

  /* ── Desktop dropdown (from trigger li) ── */
  .has-dropdown {
    position: relative;
  }
  .mn-mobile-sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 999;
    border-radius: 2px;
    background: oklch(0.155 0.034 281.7 / 0.95);
    border: 1px solid var(--color-border-bright);
    box-shadow:
      0 16px 48px var(--color-scrim-15),
      0 4px 12px var(--color-scrim-15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  /* Hover bridge works naturally — :hover on parent covers trigger + dropdown */
  .has-dropdown:hover .mn-mobile-sub,
  .has-dropdown:focus-within .mn-mobile-sub {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .mn-mobile-sub .mn-inner {
    display: flex;
    gap: 0.5rem;
  }
  .nav-mobile-cta {
    display: none;
  }

  .nav-mobile-search {
    display: none;
  }
  .nav-ext {
    font-size: 0.7rem;
    opacity: 0.6;
    margin-left: 0.3rem;
  }

  .nav-icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.45rem;
    border-radius: 4px;
    color: var(--color-text-secondary);
    transition:
      color 0.2s,
      background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
  }
  #nav-search-btn {
    margin-left: auto;
  }
  .nav-icon-btn:hover {
    color: var(--color-text);
    background: var(--color-border);
  }

  .nav-cta {
    font-size: 0.88rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-white);
    background: linear-gradient(
      to bottom,
      var(--color-cta-red),
      var(--color-cta-red-dark)
    );
    border-radius: 2px;
    padding: 0.6rem 1.5rem;
    text-decoration: none;
    display: inline-block;
    flex-shrink: 0;
    margin-left: 0.25rem;
    transition: opacity 0.15s;
  }
  .nav-cta-desktop {
    font-size: 0.88rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    display: inline-block;
    flex-shrink: 0;
    margin-left: 0.25rem;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .nav-cta-desktop:hover {
    color: var(--color-text);
    background: var(--color-surface-subtle);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
    z-index: 1001;
  }

  @media (max-width: 900px) {
    nav {
      padding: 0.55rem 1rem;
    }

    .nav-toggle {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-left: 0;
    }
    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--color-text-primary);
      border-radius: 1px;
      transition:
        transform 0.2s,
        opacity 0.2s;
    }
    .nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(4px, 4px);
    }
    .nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(4px, -4px);
    }

    .nav-links {
      display: none;
      position: fixed;
      inset: 0;
      height: 100dvh;
      background: oklch(0.155 0.034 281.7 / 0.95);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      flex-direction: column;
      padding: 5rem 2rem 2rem;
      overflow-y: auto;
      z-index: 1000;
    }
    .nav-links.open {
      display: flex;
    }

    .nav-link-btn {
      font-size: 1.1rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--color-border);
      width: 100%;
      justify-content: space-between;
    }

    .nav-mobile-search {
      display: block;
    }

    .nav-mobile-search-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.8rem 0;
      font-family: "Roboto", sans-serif;
      font-weight: 600;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--color-text-primary);
      background: none;
      border: none;
      border-bottom: 1px solid var(--color-border);
      cursor: pointer;
      text-align: left;
    }

    .nav-cta,
    .nav-cta-desktop {
      display: none;
    }
    .nav-mobile-cta {
      display: block;
    }
  }

  .nav-hidden {
    transform: translateY(-100%);
  }

  /* ── Light mode (existing) ── */
  :global(.light) nav {
    background: oklch(1 0 0 / 0.95) !important;
    border-bottom-color: oklch(0 0 0 / 0.1) !important;
  }
  :global(.light) nav a:not(.nav-cta),
  :global(.light) .nav-link-btn,
  :global(.light) .nav-toggle span,
  :global(.light) .theme-toggle {
    color: oklch(0.228 0.038 282.9) !important;
  }
  :global(.light) .nav-icon-btn {
    color: oklch(0.228 0.038 282.9);
  }
  :global(.light) .nav-icon-btn:hover {
    color: oklch(0.228 0.038 282.9);
    background: oklch(0 0 0 / 0.06);
  }
  :global(.light) a.nav-cta {
    background: linear-gradient(
      to bottom,
      var(--color-cta-red),
      var(--color-cta-red-dark)
    ) !important;
    color: var(--color-white) !important;
  }
  :global(.light) .nav-cta-desktop {
    color: oklch(0.228 0.038 282.9);
    border-color: oklch(0 0 0 / 0.15);
    background: transparent !important;
  }
  :global(.light) .nav-cta-desktop:hover {
    background: oklch(0 0 0 / 0.04);
  }
  :global(.light) .nav-links {
    background: oklch(1 0 0 / 0.95) !important;
  }
  :global(.light) .mn-link-label {
    color: oklch(0.2 0 0);
  }
  :global(.light) .mn-link:hover {
    background: oklch(0 0 0 / 0.04);
  }
  :global(.light) .mn-section-label {
    color: oklch(0.5 0 0);
  }
  :global(.light) .mn-mobile-sub {
    background: oklch(1 0 0) !important;
  }

  /* ═══════════════════════════════════════════
     MEGA DROPDOWN STYLES
     ═══════════════════════════════════════════ */

  .mn-group {
    min-width: 180px;
    max-width: 220px;
    flex-shrink: 0;
  }
  .mn-group-full {
    max-width: none;
    min-width: 220px;
  }

  .mn-section-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    padding: 0.65rem 1.2rem 0.3rem;
    margin: 0;
    opacity: 0.7;
  }
  .mn-items {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .mn-link {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.65rem 1.2rem;
    border-radius: 2px;
    text-decoration: none;
    transition:
      color 0.12s,
      background 0.12s;
    color: var(--color-text-primary);
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .mn-link:hover,
  .mn-link:focus-visible {
    background: var(--color-surface-subtle);
    outline: none;
  }
  .mn-link:focus-visible {
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  .mn-link-label {
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .mn-mobile-sub {
      /* Override desktop: show inline on mobile via class toggle */
      position: static;
      display: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition: none;
      box-shadow: none;
      border: none;
      background: transparent;
      backdrop-filter: none;
    }
    .nav-item.open .mn-mobile-sub {
      display: block;
    }
    .mn-mobile-sub .mn-inner {
      padding: 0 0 0.5rem 0;
      display: block;
    }
    .mn-mobile-sub .mn-group {
      max-width: none;
      min-width: 0;
    }
    .mn-mobile-sub .mn-link {
      padding: 0.6rem 0 0.6rem 1rem;
    }
    .mn-mobile-sub .mn-section-label {
      padding: 0.6rem 0 0.2rem 0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;

    // ── Mobile hamburger toggle ──
    const toggle = navbar.querySelector(".nav-toggle");
    const navLinks = navbar.querySelector(".nav-links");

    if (toggle && navLinks) {
      function closeMenuMob() {
        navLinks.classList.remove("open");
        toggle.classList.remove("active");
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        toggle.focus();
        navLinks
          .querySelectorAll(".has-dropdown.open")
          .forEach(function (item) {
            item.classList.remove("open");
          });
      }
      function openMenuMob() {
        navLinks.classList.add("open");
        toggle.classList.add("active");
        toggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
        navbar.classList.remove("nav-hidden");
      }
      toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        if (navLinks.classList.contains("open")) {
          closeMenuMob();
        } else {
          openMenuMob();
        }
      });

      // Mobile accordion — tap trigger to expand sub-items
      navLinks
        .querySelectorAll(".has-dropdown > .mn-trigger")
        .forEach(function (btn) {
          btn.addEventListener("click", function (e) {
            if (window.innerWidth <= 900) {
              e.preventDefault();
              const item = btn.closest(".has-dropdown");
              if (!item) return;
              navLinks
                .querySelectorAll(".has-dropdown.open")
                .forEach(function (other) {
                  if (other !== item) other.classList.remove("open");
                });
              item.classList.toggle("open");
            }
          });
        });

      // Close mobile menu on sub-link click
      navLinks
        .querySelectorAll(".mn-mobile-sub .mn-link")
        .forEach(function (link) {
          link.addEventListener("click", function () {
            if (window.innerWidth <= 900) {
              closeMenuMob();
            }
          });
        });

      // Close mobile menu on backdrop click
      navLinks.addEventListener("click", function (e) {
        if (e.target === navLinks && window.innerWidth <= 900) closeMenuMob();
      });
    }

    // ── Scroll-to-hide nav + banner ──
    let prevScrollPos =
      window.pageYOffset || document.documentElement.scrollTop;
    let ticking = false;
    let isVisible = true;
    const banner = document.getElementById("ep-banner");

    function getNavOffset() {
      return parseInt(getComputedStyle(navbar).top) || 0;
    }

    function setBannerState(atTop) {
      if (!banner) return;
      if (atTop) {
        banner.style.transform = "translateY(0)";
        navbar.style.top = "40px";
      } else {
        banner.style.transform = "translateY(-100%)";
        navbar.style.top = "0";
      }
    }

    function updateNavbar() {
      const raw = window.pageYOffset || document.documentElement.scrollTop;
      const cur = Math.max(0, raw);

      // ── Banner: only visible at top ──
      setBannerState(raw <= 0 || cur <= 50);

      // ── Nav: scroll-based hide/show ──
      if (raw <= 0 || cur <= 50) {
        if (!isVisible) {
          navbar.style.transform = "translateY(0)";
          isVisible = true;
        }
        prevScrollPos = cur;
        ticking = false;
        return;
      }
      const dh = document.documentElement.scrollHeight,
        wh = window.innerHeight;
      if (cur + wh >= dh - 50) {
        if (!isVisible) {
          navbar.style.transform = "translateY(0)";
          isVisible = true;
        }
        prevScrollPos = cur;
        ticking = false;
        return;
      }
      if (Math.abs(cur - prevScrollPos) < 3) {
        ticking = false;
        return;
      }
      if (prevScrollPos > cur && !isVisible) {
        navbar.style.transform = "translateY(0)";
        isVisible = true;
      } else if (prevScrollPos < cur && isVisible && cur > 100) {
        const offset = getNavOffset();
        navbar.style.transform = `translateY(calc(-100% - ${offset}px))`;
        isVisible = false;
      }
      prevScrollPos = cur;
      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        requestAnimationFrame(updateNavbar);
        ticking = true;
      }
    }
    window.addEventListener("scroll", requestTick, { passive: true });

    let bounceCheck = null;
    window.addEventListener(
      "scroll",
      function () {
        if (bounceCheck) clearTimeout(bounceCheck);
        bounceCheck = setTimeout(function () {
          const finalScroll = Math.max(
            0,
            window.pageYOffset || document.documentElement.scrollTop,
          );
          if (finalScroll <= 50 && !isVisible) {
            navbar.style.transform = "translateY(0)";
            isVisible = true;
            prevScrollPos = finalScroll;
            setBannerState(true);
          }
        }, 150);
      },
      { passive: true },
    );

    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) {
        const cur = Math.max(
          0,
          window.pageYOffset || document.documentElement.scrollTop,
        );
        if (cur <= 50) {
          navbar.style.transform = "translateY(0)";
          isVisible = true;
          prevScrollPos = cur;
          setBannerState(true);
        }
      }
    });
  });
</script>
