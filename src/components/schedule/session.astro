---
import { formatInTimeZone } from "date-fns-tz";
import Speakers from "./speakers.astro";
import { slugify } from "@utils/content";
import Icon from "@ui/Icon.astro";

export interface props {
  style: any;
  session: {
    slug?: string;
    title: string;
    start: Date;
    end: Date;
    description?: string;
    level?: string | null;
    speakers?: { code: string }[];
    sessionType?: string;
    rooms: string[];
  };
}

const { style, session } = Astro.props;

const hasRoom = session.rooms.length === 1;
const hasSpeakers = session.speakers && session.speakers.length > 0;
//const hasFooter = hasRoom || hasSpeakers;
const hasFooter = true;
---

<div class:list={["session", session.level, slugify(session.sessionType)]} style={style}>
  <!--
  <header>
    {
      session.sessionType === "poster" && (
        <>
          <span class="sr-only">Session type:</span>
          Poster
        </>
      )
    }
    {
      session.sessionType !== "poster" && session.level && (
        <>
          <span class="sr-only">Session level:</span>
          {session.level}
        </>
      )
    }
    </header>
    -->
    <header>

        {session.rooms.length === 1 && (
          <div class="room-info">
            <span class="sr-only">Room:</span>
            {session.rooms && session.rooms.join(", ")} ⇢
          </div>
        )}
    </header>


  <!--   <div class="time">
    <span class="sr-only">Session start:</span>
    <time>
      {formatInTimeZone(session.start, "Europe/Prague", "HH:mm")}
    </time>

    <span class="minus">-</span>
    <span class="sr-only">Session end:</span>
    <time>{formatInTimeZone(session.end, "Europe/Prague", "HH:mm")}</time>
  </div>
  -->

  <h2>{session.title}</h2>

  {
    hasFooter && (
      <footer class:list={{ "has-room": hasRoom, "has-speakers": hasSpeakers }}>
        {session.speakers && (
          <>
            <Speakers speakers={session.speakers} />
          </>
        )}

      </footer>
    )
  }

  <a href={session.slug && `/session/${session.slug}`} class="read-more">
    <span class="sr-only">Read more</span>
  </a>
</div>

<style>
  .session {

    border: 1px solid transparent;
    font-weight: bold;
    display: flex;
    flex-direction: column;
    /*background-color: var(--color-body-background);*/

    background-color: color-mix(
      in srgb,
      var(--color-body-background),
      white 30%
    );
    position: relative;

    grid-template-areas:
      "header header"
      "time title"
      "time footer";

    grid-template-columns: 60px 1fr;

    /*@media screen and (min-width: 640px) {*/
    /*  display: flex;*/
    /*}*/
  }

  .room-info {
    display: block;
    text-align:center;


    @media screen and (min-width: 800px) {
      display: none;
    }
  }

  .session > header {
    grid-area: header;
  }

  .read-more {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;

  }

  footer :global(a) {
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 800px) {
    header {
      /*text-align:right;*/
    }
    .session h2{
      padding:0 8px ;
      margin:0;
    }

    .session > .time {
      grid-area: time;
      padding-block: 8px;

      display: flex;
      flex-direction: column;
      align-items: center;
      /*border-right: 1px solid var(--color-text);*/
      gap: 4px;

      & .minus {
        display: none;
      }
    }

    .session > h2 {
      grid-area: title;
      padding-block: 0;
    }

    .session > footer {
      grid-area: footer;
    }

    .session > div {
      display: flex;
    }
  }

  .session:has(.read-more[href]:focus) {
    background-color: color-mix(
      in srgb,
      var(--color-body-background),
      white 70%
    );
    border: 1px solid #33333366;
  }

  .session:has(.read-more[href]:not([href=""]):hover) {
    background-color: color-mix(
      in srgb,
      var(--color-body-background),
      white 50%
        );
    border: 1px solid #E9714D;
  }


  .time,
  footer {
    font-size: 0.9em;
  }

  header,
  .time,
  footer,
  h2 {
    padding: 0.2em 0.5em;
  }

  h2 {
    margin-bottom: 1em;
    height:100%;
  }

  footer.has-speakers {
    /*border-top: 1px solid var(--color-text);*/

    margin-top: 5px;
  }

  header {
    /*background-color: var(--color-primary);*/
    /*border-bottom: 2px solid var(--color-primary);*/
    /*background-color: #e6c8ac;*/
    text-transform: capitalize;
    font-size: 0.8em;
    font-weight: 500;
  }

  .beginner header {
    /*background-color: var(--color-session-beginner);*/
  }

  .intermediate header {
    /*background-color: var(--color-session-intermediate);*/
  }

  .advanced header {
    /*background-color: var(--color-session-advanced);*/
  }

  .poster header {
    /*background-color: var(--color-secondary);*/
  }
</style>
