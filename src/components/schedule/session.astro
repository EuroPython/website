---
import Speakers from "./speakers.astro";
import { slugify } from "@utils/content";

export interface props {
  style: any;
  session: {
    code: string;
    slug?: string;
    title: string;
    start: Date;
    end: Date;
    description?: string;
    duration?: string | number;
    level?: string | null;
    speakers?: { code: string }[];
    sessionType?: string;
    rooms: string[];
  };
}

const { style, session } = Astro.props;

const hasRoom = session.rooms.length === 1;
const durationLabel = session.duration ? `${session.duration}min` : "";
const levelLabel = session.level ? session.level.charAt(0).toUpperCase() + session.level.slice(1) : "";
const sessionUrl = session.slug ? `/session/${session.slug}` : "#";
---

<div
  class:list={["ep-session", session.level, slugify(session.sessionType)]}
  style={style}
>
  <a href={sessionUrl} class="ep-session-title">{session.title}</a>

  {session.speakers && session.speakers.length > 0 && (
    <div class="ep-session-speakers">
      <Speakers speakers={session.speakers} />
    </div>
  )}

  <div class="ep-session-meta">
    {hasRoom && <span class="ep-session-room">{session.rooms[0]}</span>}
    {durationLabel && <span class="ep-session-duration">{durationLabel}</span>}
  </div>
  {levelLabel && <div class={`ep-session-level--${session.level}`}>{levelLabel}</div>}
</div>

<style>
  .ep-session {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.6rem;
    background: var(--ep-surface-subtle);
    border: 1px solid var(--ep-border);
    border-radius: 6px;
    color: var(--ep-white);
    font-family: "Inter Tight", system-ui, sans-serif;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }

  .ep-session:hover {
    border-color: var(--ep-accent);
    background: #0f1a2e !important;
    z-index: 10;
  }

  .ep-session-title {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ep-white);
    text-decoration: none;
    margin: 0;
    padding: 0;
  }

  .ep-session-title:hover {
    text-decoration: underline;
  }

  .ep-session-speakers {
    font-size: 0.85rem;
    color: var(--ep-text-secondary);
    line-height: 1.3;
  }

  .ep-session-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--ep-text-muted);
    font-weight: 500;
    line-height: 1.4;
    margin-top: auto;
  }

  .ep-session-room,
  .ep-session-duration {
    display: inline;
  }

  .ep-session-duration::before {
    content: "·";
    margin-right: 0.3rem;
    opacity: 0.5;
  }

  .ep-session-level--beginner {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #6fd66f;
  }

  .ep-session-level--intermediate {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ep-text-muted, rgba(255,255,255,0.7));
  }

  .ep-session-level--advanced {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #e07070;
  }



  @media screen and (max-width: 800px) {
    .ep-session-title {
      font-size: 0.9rem;
    }
  }

  .beginner {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 4px,
        rgba(50,180,50,0.2) 4px,
        rgba(50,180,50,0.2) 6px
      ),
      var(--ep-surface-subtle);
  }

  .advanced {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 4px,
        rgba(200,50,50,0.2) 4px,
        rgba(200,50,50,0.2) 6px
      ),
      var(--ep-surface-subtle);
  }
</style>
