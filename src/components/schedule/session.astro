---
import CodeHeart from "@components/island/CodeHeart.svelte";
import Speakers from "./speakers.astro";
import { slugify } from "@utils/content";

export interface props {
  style: any;
  session: {
    code: string;
    slug?: string;
    title: string;
    start: Date;
    end: Date;
    description?: string;
    level?: string | null;
    speakers?: { code: string }[];
    sessionType?: string;
    rooms: string[];
  };
}

const { style, session } = Astro.props;

const hasRoom = session.rooms.length === 1;
const hasSpeakers = session.speakers && session.speakers.length > 0;
//const hasFooter = hasRoom || hasSpeakers;
const hasFooter = true;
---

<div
  class:list={["ep-session", session.level, slugify(session.sessionType)]}
  style={style}
>
  <header>
    {
      session.rooms.length === 1 && (
        <div class="room-info">
          <span class="sr-only">Room:</span>
          {session.rooms && session.rooms.join(", ")}
        </div>
      )
    }
  </header>

  <CodeHeart
    client:load
    mini={true}
    codeId={session.code}
    title={session.title}
  />
  <h2 id=`session-${session.slug}`>
    {session.title}
  </h2>

  {
    hasFooter && (
      <footer class:list={{ "has-room": hasRoom, "has-speakers": hasSpeakers }}>
        {session.speakers && (
          <>
            <Speakers speakers={session.speakers} />
          </>
        )}

      </footer>
    )
  }

  <a href={session.slug ? `/session/${session.slug}` : '#'} class="read-more">
    <span class="sr-only">Read more</span>
  </a>
</div>

<style>
  .ep-session {
    border: 1px solid var(--ep-border);
    font-weight: 600;
    display: flex;
    flex-direction: column;
    background: var(--ep-surface-subtle);
    position: relative;
    padding: 0.5rem 0.6rem;
    gap: 0.15rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .room-info {
    display: block;
    text-align: center;
    font-size: 0.72rem;
    color: var(--ep-text-muted);
    font-weight: 500;

    @media screen and (min-width: 800px) {
      display: none;
    }
  }

  .ep-session > header {
    padding: 0;
    margin-bottom: 0.1rem;
  }

  .ep-session h2 {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ep-white);
    margin: 0;
    padding: 0;
    height: auto;
    margin-bottom: 0;
  }

  .read-more {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
  }

  .read-more:focus {
    outline: 2px solid var(--ep-accent);
    outline-offset: 2px;
    border-radius: 6px;
  }

  footer :global(a) {
    position: relative;
    z-index: 2;
  }

  footer {
    font-size: 0.75rem;
    color: var(--ep-text-secondary);
    margin-top: 0.2rem;
    padding: 0;
  }

  @media screen and (max-width: 800px) {
    .ep-session h2 {
      padding: 0 0.5rem;
      margin: 0;
      font-size: 0.9rem;
    }
  }

  .ep-session:has(.read-more[href]:focus) {
    border-color: var(--ep-accent);
    background: var(--ep-surface-medium);
  }

  .ep-session:hover {
    border-color: var(--ep-accent);
    background: var(--ep-surface-medium);
  }

  header {
    text-transform: capitalize;
    font-size: 0.75em;
    font-weight: 500;
    color: var(--ep-text-muted);
    padding: 0;
  }

  .beginner {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 4px,
        rgba(50,180,50,0.2) 4px,
        rgba(50,180,50,0.2) 6px
      ),
      var(--ep-surface-subtle);
  }

  .advanced {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 4px,
        rgba(200,50,50,0.2) 4px,
        rgba(200,50,50,0.2) 6px
      ),
      var(--ep-surface-subtle);
  }

  .poster header {
    text-align: center;
  }
</style>
