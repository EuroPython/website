---
import { type CollectionEntry, getCollection } from "astro:content";
import Break from "@components/schedule/break.astro";
import Session from "@components/schedule/session.astro";
import { addMinutes, differenceInMinutes, parseISO } from "date-fns";
import { formatInTimeZone } from "date-fns-tz";

interface Props {
  day: CollectionEntry<"days">;
}

const format = (date: Date, format: string) => {
  return formatInTimeZone(date, "Europe/Warsaw", format);
};

const timeToNumber = (time: string) => {
  const [hours, minutes] = time.split(":").map(Number);
  return hours * 60 + minutes;
};

const numberToTime = (number: number) => {
  const hours = Math.floor(number / 60);
  const minutes = number % 60;
  return `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}`;
};

export const getStaticPaths = async () => {
  const days = await getCollection("days");

  return days.map((day) => {
    return { params: { day: day.id } };
  });
};

const { day } = Astro.props;
const dayName = day.id;
//const day = getEntry("days", dayName);

// Predefined display order; rooms not listed here sort last, alphabetically.
const ROOM_ORDER = [
  "S1",
  "S2",
  "S3A",
  "S3B",
  "S4",
  "S4A",
  "S4B",
  "Glass room",
  "2.017/2.018",
  "Fishbowl",
  "Exhibit Hall",
];

const getRoomSortKey = (room: string) => {
  const index = ROOM_ORDER.indexOf(room);
  return index === -1 ? ROOM_ORDER.length : index;
};

const ROOMS = (day.data.rooms ?? [])
  .filter((room) => room.toLowerCase() !== "exhibit hall")
  .sort((a, b) => getRoomSortKey(a) - getRoomSortKey(b) || a.localeCompare(b));

type ScheduleSession = {
  title: string;
  start: Date;
  startTime: string;
  end: Date;
  endTime: string;
  duration: number;
  sessionType?: string | undefined;
  type: string;
  rooms: string[];
  slug?: string;
};

// hack for posters :)
const posters: Array<ScheduleSession> = [];

const isLunchSideEvent = (session: ScheduleSession): boolean => {
  const title = session.title.toLowerCase();
  return title === "pyladies lunch" || title === "communities organizers lunch";
};

const lunchSideEvents: Array<ScheduleSession> = [];

const sessions = day.data.events
  .map((event) => {
    const start = parseISO(event.start);
    const startTime = format(start, "HH:mm");

    let duration = event.duration;

    // round to the nearest 5 minutes
    duration = Math.ceil(duration / 5) * 5;

    const end = addMinutes(start, duration);
    const endTime = format(end, "HH:mm");

    const session: ScheduleSession = {
      ...event,
      start,
      startTime,
      end,
      endTime,
      sessionType: event.session_type?.toLowerCase(),
      type: event.event_type,
      slug: event.slug ? event.slug : "#",
    };

    if (session.sessionType === "poster") {
      posters.push(session);
    }

    if (isLunchSideEvent(session)) {
      lunchSideEvents.push(session);
    }

    return session;
  })
  .sort((a, b) => {
    return a!.start.getTime() - b!.start.getTime();
  }) as Array<ScheduleSession>;

const sessionsByTime: { [key: string]: Array<(typeof sessions)[0]> } = {};

sessions.forEach((session) => {
  if (!sessionsByTime[session.startTime]) {
    sessionsByTime[session.startTime] = [];
  }

  sessionsByTime[session.startTime].push(session);
});

const sessionAndTimes = Object.entries(sessionsByTime).sort(([a], [b]) => {
  return timeToNumber(a) - timeToNumber(b);
});

// storing some time slots to skip, I don't like it, but it's the easiest way to hide some
// gaps in the schedule

const timesToSkip: Array<string> = [];

for (let i = 0; i < sessionAndTimes.length - 1; i++) {
  const [, sessions] = sessionAndTimes[i];
  const [, nextSessions] = sessionAndTimes[i + 1];

  const ends = sessions.map((session) => session.end);
  const nextStart = nextSessions[0].start;
  const candidateEndTimes = ends
    .filter(
      // skip talks than end after the next start,
      // this is for events that span for multiple slots
      // (like a sponsor fair)
      (end) => end.getTime() <= nextStart.getTime(),
    )
    .map((end) => end.getTime());

  if (candidateEndTimes.length === 0) {
    continue;
  }

  const end = new Date(Math.max(...candidateEndTimes));

  const hasBreakAfter = nextSessions.some(
    (session) => session.type === "break",
  );

  if (nextStart !== end) {
    const duration = differenceInMinutes(nextStart, end);

    if (duration >= 5) {
      const roomChangeTime = format(end, "HH:mm");
      if (hasBreakAfter) {
        timesToSkip.push(roomChangeTime);
        continue;
      }

      timesToSkip.push(roomChangeTime);
      continue;
    } else {
      if (duration != 0) {
        console.warn("Missing room change", end, nextStart, duration);
      }
    }
  }
}

const slots = Object.entries(sessionsByTime)
  .sort()
  .map(([, sessions]) => {
    let type: "session" | "break" | "lunch" | "room-change" = "session";

    if (sessions.every((session) => session.type === "break")) {
      type = "break";
    } else if (
      // on some days we have lunch and posters in parallel :')
      sessions.some((session) => session.title.toLowerCase().includes("lunch"))
    ) {
      type = "lunch";
    } else if (sessions.every((session) => session.type === "room-change")) {
      type = "room-change";
    }

    return {
      start: sessions[0].start,
      startTime: sessions[0].startTime,
      end: sessions[0].end,
      endTime: sessions[0].endTime,
      type: type,
      sessions,
    };
  });

// Merge adjacent 5-minute-apart session slots when earlier sessions
// are still running into the later slot. Fixes cases like 14:30 (one room)
// and 14:35 (other rooms) where timeline shows two close start times.
for (let i = slots.length - 1; i > 0; i--) {
  const current = slots[i];
  const prev = slots[i - 1];

  if (current.type !== "session" || prev.type !== "session") continue;

  const gap = timeToNumber(current.startTime) - timeToNumber(prev.startTime);
  if (gap !== 5) continue;

  // Only merge when all earlier-slot sessions are still running
  // at the later slot's start time
  const allStillRunning = prev.sessions.every(
    (s) => s.end.getTime() > current.start.getTime(),
  );
  if (!allStillRunning) continue;

  // Merge: combine sessions into the earlier slot
  prev.sessions.push(...current.sessions);

  // Update end to the latest among merged sessions
  const allEnds = prev.sessions.map((s) => s.end.getTime());
  const latestEnd = new Date(Math.max(...allEnds));
  prev.end = latestEnd;
  prev.endTime = format(latestEnd, "HH:mm");

  // Remove the later slot
  slots.splice(i, 1);
}

// Find the main Lunch break slot to place posters inside it
// We match exact title "Lunch" (case-insensitive) to get the communal
// lunch break, not side events like "PyLadies Lunch"
const lunchSlotForPosters = slots.find((slot) =>
  slot.sessions.some((s) => s.title.toLowerCase() === "lunch"),
);

const gridRows: string[] = [];

let row = 1;

const timeToRow: { [key: string]: number } = {};

for (let i = 0; i < slots.length; i++) {
  const current = slots[i];
  const next = slots[i + 1];

  const currentTime = timeToNumber(current.startTime);

  let nextTime: number;

  if (next) {
    nextTime = timeToNumber(next.startTime);
  } else {
    nextTime = timeToNumber(current.endTime);
  }

  const sizeInMinutes = nextTime - currentTime;
  let size = sizeInMinutes / 5;

  let rowSize = `fit-content(100px)`;

  if (current.type === "break") {
    // we might have some "breaks" that are quite short, for example
    // a time to setup the lighting talks, which lasts only 5 minutes
    // so we give the row a minimum size of 3, so we never have
    // visually small breaks :)
    size = Math.max(3, size);

    // When the "Lunch" break also holds posters, we need taller rows
    // so the poster cards don't overflow into sessions below.
    // The var(--break) = 14px per row is way too small for posters.
    if (
      lunchSlotForPosters &&
      posters.length > 0 &&
      current.startTime === lunchSlotForPosters.startTime
    ) {
      rowSize = `auto`;
    } else {
      rowSize = `var(--break)`;
    }
  } else if (current.type === "room-change") {
    size = 1;
    rowSize = `var(--room-change)`;
  }

  const rowTimes = Array.from({ length: size }, (_, i) =>
    numberToTime(currentTime + i * 5),
  );
  const visibleRowCount = rowTimes.filter(
    (time) => !timesToSkip.includes(time),
  ).length;

  if (visibleRowCount > 0) {
    gridRows.push(`repeat(${visibleRowCount}, ${rowSize})`);
  }

  for (const time of rowTimes) {
    timeToRow[time] = row;

    if (!timesToSkip.includes(time)) {
      row += 1;
    }
  }
}

// add missing times
const lastSlot = slots[slots.length - 1];
const lastTime = Math.max(
  ...lastSlot.sessions.map((session) => timeToNumber(session.endTime)),
);
const currentTime = timeToNumber(lastSlot.endTime);

for (let i = currentTime; i <= lastTime; i += 5) {
  const time = numberToTime(i);
  timeToRow[time] = row;
  row += 1;
}

type Session = {
  type: "break" | "room-change" | "session";
  slug?: string;
  sessionType: string;
  rooms: string[];
};

const spansAllRooms = (rooms: string[]) => {
  return ROOMS.every((room) => rooms.includes(room));
};

const getColStart = ({ type, rooms }: Session) => {
  if (type === "room-change") {
    return 2;
  }

  if (type === "break" && spansAllRooms(rooms)) {
    return 2;
  }

  const indexes = rooms
    .map((room) => ROOMS.indexOf(room))
    .filter((index) => index >= 0);

  if (indexes.length === 0) {
    return 1;
  }

  return Math.min(...indexes) + 2;
};

const getColEnd = ({ type, rooms }: Session) => {
  if (type === "room-change" || (type === "break" && spansAllRooms(rooms))) {
    return -1;
  }

  const indexes = rooms
    .map((room) => ROOMS.indexOf(room))
    .filter((index) => index >= 0);

  if (indexes.length === 0) {
    return -1;
  }

  return Math.max(...indexes) + 3;
};

const getSessionStyle = (session: any) => {
  const startRow = timeToRow[session.startTime];
  const style = {
    "--start": startRow,
    "--end":
      session.type === "room-change"
        ? startRow + 1
        : timeToRow[session.endTime],
    "--col-start": getColStart(session),
    "--col-end": getColEnd(session),
  };

  if (!style["--end"]) {
    throw new Error(`Session ${session.title} is missing an end time`);
  }

  return style;
};

const sortSessionByRooms = (a: ScheduleSession, b: ScheduleSession) => {
  const aIndex = ROOMS.indexOf(a.rooms[0]);
  const bIndex = ROOMS.indexOf(b.rooms[0]);

  return aIndex - bIndex;
};

const postersByTime: { [key: string]: Array<ScheduleSession> } = {};

posters.forEach((poster) => {
  if (!postersByTime[poster.startTime]) {
    postersByTime[poster.startTime] = [];
  }

  postersByTime[poster.startTime].push(poster);
});

const date = parseISO(`${dayName}T12:00:00Z`);
const dateText = format(date, "eeee d MMMM");

const lastEndTime = Math.max(
  ...slots.flatMap((slot) => slot.sessions.map((s) => timeToNumber(s.endTime))),
);

const endStart = numberToTime(lastEndTime);
---

<div class="day ep-sched-day" data-day={dayName}>
  <h3 class="ep-sched-day-title" id={`day-${dayName}`}>
    <a href={`#day-${dayName}`} aria-label={`Jump to ${dateText}`}>{dateText}</a
    >
  </h3>

  <div class="schedule-wrapper">
    <header class="schedule-container header">
      <div
        class="schedule"
        style={{
          gridTemplateColumns: `80px repeat(${ROOMS.length}, minmax(100px, 1fr))`,
        }}
      >
        <div>Time</div>
        {ROOMS.map((room) => <div>{room}</div>)}
      </div>
    </header>

    <div class="schedule-container">
      <div
        class="schedule"
        style={{
          gridTemplateRows: gridRows.join(" "),
          gridTemplateColumns: `80px repeat(${ROOMS.length}, minmax(100px, 1fr))`,
        }}
      >
        {
          slots.map((slot) => (
            <div class="slot">
              {slot.type !== "room-change" &&
                (() => {
                  const hasRegular = (slot.sessions ?? []).some(
                    (s) => s.sessionType !== "poster" && !isLunchSideEvent(s),
                  );
                  const hasPosterBlock =
                    lunchSlotForPosters &&
                    slot.startTime === lunchSlotForPosters.startTime &&
                    (posters.length > 0 || lunchSideEvents.length > 0);
                  return hasRegular || hasPosterBlock;
                })() && (
                  <div
                    class="time"
                    style={{
                      "--start": timeToRow[slot.startTime],
                      "--end": timeToRow[slot.endTime],
                    }}
                  >
                    <h2>{format(slot.start, "HH:mm")}</h2>
                  </div>
                )}

              {(slot.sessions ?? [])
                .sort(sortSessionByRooms)
                .filter((session) => {
                  if (session.sessionType === "poster") return false;
                  if (isLunchSideEvent(session)) return false;
                  // Hide the "Lunch" break session — shown inside lunch-block
                  // Only hide when there are actually posters or side events to show
                  if (
                    lunchSlotForPosters &&
                    slot.startTime === lunchSlotForPosters.startTime &&
                    session.title.toLowerCase() === "lunch" &&
                    (posters.length > 0 || lunchSideEvents.length > 0)
                  )
                    return false;
                  return true;
                })
                .map((session) => {
                  const style = getSessionStyle(session);

                  if (session.type === "room-change") {
                    return (
                      <Break
                        title={session.title}
                        time={session.startTime}
                        className="break room-change"
                        style={style}
                      />
                    );
                  }

                  if (session.type === "break") {
                    return (
                      <Break
                        title={session.title}
                        time={session.startTime}
                        style={style}
                      />
                    );
                  }

                  return <Session session={session} style={style} />;
                })}

              {lunchSlotForPosters &&
                slot.startTime === lunchSlotForPosters.startTime &&
                (posters.length > 0 || lunchSideEvents.length > 0) && (
                  <div
                    class="break ep-break lunch-break"
                    style={{
                      "--start": timeToRow[lunchSlotForPosters.startTime],
                      "--end": timeToRow[lunchSlotForPosters.endTime],
                      gridRow: "var(--start) / var(--end)",
                      gridColumn: "2 / -1",
                      flexDirection: "column",
                    }}
                  >
                    <div class="lunch-break-header">
                      {lunchSlotForPosters.startTime} Lunch
                    </div>
                    <div
                      class="lunch-break-content"
                      style={{
                        display: "grid",
                        gridTemplateColumns: `80px repeat(${ROOMS.length}, minmax(90px, 1fr))`,
                      }}
                    >
                      {posters.length > 0 && (
                        <div
                          class="posters-inside"
                          style={{
                            gridColumn: "1 / -1",
                            justifySelf: "center",
                          }}
                        >
                          <h2>Posters ({posters[0].rooms.join(", ")})</h2>
                          <div class="poster-cards">
                            {posters.map((session) => {
                              const style = {};
                              return (
                                <div>
                                  <Session
                                    session={session}
                                    style={style}
                                    sessionType="poster"
                                  />
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}
                      {lunchSideEvents.length > 0 && (
                        <>
                          <hr class="sched-lunch-hr" />
                          <div class="sched-lunch-events">
                            <div class="sched-lunch-events-label">
                              Also During Lunch
                            </div>
                            <ul class="sched-posters-list">
                              {lunchSideEvents.map((session) => (
                                <li>
                                  <a href={`/session/${session.slug}`}>
                                    {session.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                )}
            </div>
          ))
        }
      </div>

      <Break
        title="End of the Day"
        time={endStart}
        className="ep-break day-end"
      />
    </div>
    <div class="h-12"></div>
  </div>
</div>

<style is:global>
  .layout-wrapper {
    display: grid;
    grid-template-columns: 1fr minmax(0, 100%) 1fr !important;
  }
</style>

<style>
  .schedule-wrapper {
    width: 100%;
    margin-top: 0.75rem;
  }

  .day {
    margin-block: 2rem 3rem;
  }

  .day:first-child {
    margin-top: 0;
  }

  :global(.ep-break.day-end) {
    display: none;
  }

  @media screen and (max-width: 799px) {
    :global(.ep-break.day-end) {
      display: flex;
      align-items: center;
      text-align: center;
      justify-items: center;
      background: var(--ep-day-end-bg);
      border: 1px solid var(--color-surface-medium);
      border-radius: 4px;
      margin: 0.5rem 0;
      padding: 0.5rem 1rem;
      font-size: 1rem;
      color: var(--ep-day-end-text);
    }
  }

  :global(.schedule *) {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 0.9rem;
  }

  .schedule {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 0;
    padding-right: 0;
  }

  .slot {
    display: contents;
  }

  :global(.session) {
    position: relative;
    z-index: 10;
  }

  :global(.session),
  .time,
  :global(.break),
  header,
  header > div > div {
    background-color: transparent;
    border-radius: 6px;
    margin: 0;
    padding: 0;
  }

  :global(.room-change) {
    align-items: center;
    display: flex;
    font-weight: 400;
    justify-content: center;
    line-height: 1.2;
    min-height: 0;
    overflow: hidden;
    white-space: nowrap;
    border: 1px solid var(--color-surface-medium);
    border-radius: 4px;
    background: var(--ep-sched-chrome-bg);
    color: var(--ep-sched-chrome-text);
    font-size: 0.9rem;
    padding: 0 8px;
  }

  :global(.break:not(.room-change)) {
    font-weight: 600;
    letter-spacing: 0;
  }

  .lunch-break .lunch-break-content {
    display: none;
  }

  .lunch-break-header {
    display: none;
  }

  .schedule-container.header {
    display: none;
  }

  @media screen and (max-width: 799px) {
    .time {
      background: transparent;
      border: 1px solid var(--ep-border);
      border-radius: 4px;
      padding: 0.3rem 0.5rem;
      margin: 2px 0;
    }
    .time h2 {
      text-align: center;
      color: var(--ep-text-secondary);
      font-size: 1.1rem;
    }
    .room-info {
      text-align: center;
    }
  }

  @media screen and (min-width: 800px) {
    .schedule-container.header {
      display: inherit;
    }

    .schedule-container {
      padding-bottom: 2px;
    }

    .schedule-container.header {
      padding-bottom: 0;
      margin-top: 0.5rem;
    }

    .schedule-container:not(.header) {
      margin-top: 0.75rem;
    }

    .time,
    header {
      display: block;
    }

    /* Header = room headers row */
    header.schedule-container.header {
      position: sticky;
      top: 0;
      background: var(--ep-sched-chrome-bg);
      z-index: 20;
    }

    header.schedule-container.header > div > div {
      padding: 0.5rem 0.3rem;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--ep-text-primary);
      background: var(--ep-sched-room-bg);
      border-radius: 4px;
      text-align: center;
    }

    header.schedule-container.header > div > div:first-child {
      background: transparent;
      color: var(--color-text-muted);
    }

    .schedule {
      --break: 14px;
      --room-change: 52px;

      display: grid;
      gap: 4px;
      padding: 0;
    }

    :global(.session),
    :global(.ep-session),
    .time,
    .posters,
    :global(.room-change),
    :global(.break) {
      grid-row: var(--start) / var(--end);
      grid-column: var(--col-start) / var(--col-end);
      display: block;
    }

    :global(.ep-break.day-end) {
      font-size: 1.1rem;
      margin: 2px;
      padding: 8px;
      background: var(--ep-day-end-bg);
      border: 1px solid var(--color-surface-medium);
      border-radius: 4px;
      color: var(--ep-day-end-text);
    }

    .time {
      padding: 0.4rem 0.5rem;
      grid-column: 1 / 2;
      outline: none;
      text-align: right;
      border-radius: 4px;
    }

    .time h2 {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-text-muted);
      margin: 0;
    }

    :global(.session.poster),
    :global(.ep-session.poster) {
      display: none;
    }

    .lunch-break:hover,
    .lunch-break:focus-within {
      z-index: 15;
    }

    .lunch-break {
      padding: 0 !important;
    }

    .lunch-break-header {
      width: 100%;
      display: block;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-size: 0.95rem;
      color: var(--ep-text-secondary);
      font-weight: 500;
      padding: 0.4rem 0.8rem;
      background: oklch(0.75 0.171 60.3 / 0.06);
      border-bottom: 1px solid oklch(0.75 0.171 60.3 / 0.18);
      text-align: center;
    }

    .lunch-break .lunch-break-content {
      background: oklch(0.75 0.171 60.3 / 0.06);
    }

    .lunch-break .posters-inside {
      border-bottom: 1px solid var(--color-surface-medium);
      text-align: left;
    }

    .lunch-break h2 {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--color-accent-themed);
      padding: 0.4rem 0.5rem;
      margin: 0;
      background: transparent;
    }

    .lunch-break .poster-cards {
      display: flex;
      flex-wrap: wrap;
    }

    .lunch-break .poster-cards :global(*) {
      flex: 1;
      max-width: 320px;
    }

    .lunch-break .posters-inside {
      padding: 0.5rem;
      border-bottom: 1px solid var(--color-surface-medium);
    }

    .sched-lunch-hr {
      grid-column: 1 / -1;
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 0.5rem 0;
    }

    .sched-lunch-events {
      grid-column: 1 / -1;
      justify-self: center;
      padding: 0.5rem;
      text-align: left;
    }

    .sched-lunch-events-label {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--color-text-muted);
      margin-bottom: 0.35rem;
      text-align: center;
    }

    .sched-posters-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;
      margin-bottom: 2rem;
    }

    .sched-posters-list a {
      display: inline-block;
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.3rem 0.7rem;
      font-size: 1.02rem;
      line-height: 1.4;
      color: var(--color-accent-themed);
