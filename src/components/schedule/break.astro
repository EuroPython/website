---
export interface Props {
  time: string;
  title: string;
  style?: any;
}

const { time, title, style }: Props = Astro.props;
---

<div class="break" style={style} aria-label=`${time} ${title}` >
  {time}{" "}
  {title}
  <span class="sr-only">{time} {title}</span>
</div>

<style>
  .break {
    display: flex;
    align-items: center;
    text-align: center;
    justify-items: center;
    padding-left: 8px;
    background-color: #FCFBFA;
  }
</style>
