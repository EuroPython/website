<style is:global>
  .sponsor-tiers-container {
    width: 100vw;
    max-width: 1400px;
    margin-left: 50%;
    transform: translateX(-50%);
    position: relative;
    padding: 0 40px;
  }

  @media (max-width: 768px) {
    .sponsor-tiers-container {
      width: 100%;
