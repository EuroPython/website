---
import Icon from "@ui/Icon.astro";

const {
  class: className,
  socials,
  variant = "color",
} = Astro.props;
const socialMap = {
  website: { icon: "globe", label: "Website", color: "oklch(0.546 0.13 242.3)" /* #0077b5 */ },
  blog: { icon: "rss", label: "Blog", color: "oklch(0.676 0.189 42.0)" /* #f26522 */, style: "solid" },
  linkedin: { icon: "linkedin", label: "LinkedIn", color: "oklch(0.516 0.163 254.7)" /* #0a66c2 */ },
  github: { icon: "github", label: "GitHub", color: "oklch(0.321 0 0)" /* #333333 */ },
  youtube: { icon: "youtube", label: "YouTube", color: "oklch(0.628 0.258 29.2)" /* #ff0000 */ },
  discord: { icon: "discord", label: "Discord", color: "oklch(0.577 0.209 273.9)" /* #5865f2 */ },
  mastodon: { icon: "mastodon", label: "Mastodon", color: "oklch(0.593 0.224 276.8)" /* #6364ff */ },
  bluesky: { icon: "bluesky", label: "Bluesky", color: "oklch(0.626 0.205 254.9)" /* #0085ff */ },
  instagram: { icon: "instagram", label: "Instagram", color: "oklch(0.619 0.2 14.6)" /* #e4405f */ },
  tiktok: { icon: "tiktok", label: "TikTok", color: "var(--color-black)" },
  facebook: { icon: "facebook", label: "Facebook", color: "oklch(0.589 0.203 257.9)" /* #1877f2 */ },
  twitter: { icon: "x-twitter", label: "Twitter", color: "oklch(0.682 0.158 243.4)" /* #1da1f2 */ },
};
---

<div class=`social-links flex justify-center space-x-4 ${className} h-[36px]`>
  {
    Object.entries(socialMap)
      .filter(([key]) => socials?.[key])
      .map(([key, { icon, label, color, style: iconStyle = "brands" }]) => {
        const url = socials[key];
        const style =
          variant === "color" && color ? `color: ${color}` : "color: currentColor";
        return (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="social-icon"
            style={style}
          >
            {" "}
            <span class="social-icon-inner">
              {" "}
              <Icon name={icon} style={iconStyle} size="fa-xl" />{" "}
            </span>{" "}
          </a>
        );
      })
  }
</div>

<style>
  .social-icon::after {
    content: none !important;
  }
</style>
