---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Section2 from "@ui/Section2.astro";
import Title from "@ui/Title.astro";
import SpeakerCard from "@ui/SpeakerCard.astro";

const speakers = await getCollection("speakers");
const sortedSpeakers = speakers
  .filter(s => !!s.data?.name)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout title="Speakers" description="All speakers at EuroPython 2026">
  <Section2 id="all-speakers">
    <div class="section-header">
      <Title id="all-speakers" subtitle={`${sortedSpeakers.length} speakers at EuroPython 2026`}>All Speakers</Title>
    </div>

    <div class="speaker-filter">
      <input type="text" id="speakerSearch" class="filter-input" placeholder="Search speakers..." />
    </div>

    <div class="speakers-grid" id="speakersGrid">
      {sortedSpeakers.map((speaker) => (
        <div class="speaker-card-wrap" data-name={speaker.data.name.toLowerCase()} style="min-width: 0">
          <SpeakerCard speaker={speaker} />
        </div>
      ))}
    </div>
  </Section2>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("speakerSearch") as HTMLInputElement | null;
    const grid = document.getElementById("speakersGrid");
    if (!input || !grid) return;
    const wraps = grid.querySelectorAll(".speaker-card-wrap");
    input.addEventListener("input", () => {
      const query = input.value.toLowerCase().trim();
      wraps.forEach((wrap) => {
        const el = wrap as HTMLElement;
        const name = el.getAttribute("data-name") || "";
        el.style.display = name.includes(query) ? "" : "none";
      });
    });
  });
</script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .speaker-filter {
    display: flex;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto 2.5rem;
  }

  .filter-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--color-surface-medium);
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    color: var(--color-text);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .filter-input::placeholder {
    color: oklch(1 0 0 / 0.5); /* rgba(255,255,255,0.5) */
  }

  .filter-input:focus {
    border-color: var(--color-accent);
  }

  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }

  @media (max-width: 1024px) {
    .speakers-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 768px) {
    .speakers-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 480px) {
    .speakers-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
