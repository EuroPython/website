---
import BingoCard from "@components/island/BingoCard.svelte";

const cellsParam = Astro.url.searchParams.get("cells") || "";
const ogImageUrl = cellsParam
  ? new URL("/api/og-bingo.png?cells=" + cellsParam, Astro.url)
  : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EuroPython 2026 Bingo — Play your own card!</title>
  <meta name="description" content="25 editions, 13 cities, one community. How many EuroPythons have you attended? Play your own bingo card!" />
  <meta property="og:title" content={cellsParam ? "EuroPython 2026 Bingo" : "EuroPython 2026 Bingo — Play your own card!"} />
  <meta property="og:description" content={cellsParam ? "25 editions, 13 cities, one community. How many have you attended?" : "25 editions, 13 cities, one community. How many EuroPythons have you attended? Play your own bingo card!"} />
  <meta property="og:site_name" content="EuroPython 2026" />
  <meta property="og:url" content={new URL("/bingo" + (cellsParam ? "?cells=" + cellsParam : ""), Astro.url)} />
  {ogImageUrl && <meta property="og:image" content={String(ogImageUrl)} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <link rel="canonical" href={new URL("/bingo", Astro.url)} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:site" content="@europython" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0b1121" />

  <style is:global>
    :root {
      --color-accent: #f0c040;
      --color-accent-themed: #f0c040;
      --color-on-accent: #0b1121;
      --color-bg-dark: #0b1121;
      --color-surface-faint: #0d1520;
      --color-surface-subtle: rgba(255,255,255,0.05);
      --color-text-primary: #ffffff;
      --color-text-secondary: rgba(255,255,255,0.6);
      --color-text-muted: rgba(255,255,255,0.45);
      --color-text-faint: rgba(255,255,255,0.35);
      --color-border: rgba(255,255,255,0.12);
      --color-border-strong: rgba(255,255,255,0.18);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--color-bg-dark);
      min-height: 100vh;
      font-family: system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1rem;
      color: var(--color-text-primary);
    }

    .bingo-page {
      width: 100%;
      max-width: 700px;
    }

    .bingo-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .bingo-title {
      font-size: clamp(2.5rem, 7vw, 4rem);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.03em;
      color: var(--color-accent);
      margin: 0 0 0.5rem;
      line-height: 0.95;
    }

    .bingo-lead {
      font-size: 1.05rem;
      color: var(--color-text-secondary);
      max-width: 400px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .bingo-link-home {
      text-align: center;
      margin-top: 0.5rem;
    }

    .bingo-link-home a {
      display: inline-block;
      color: var(--color-text-muted);
      font-size: 0.85rem;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.15s;
    }

    .bingo-link-home a:hover {
      opacity: 0.7;
    }
  </style>
</head>
<body>
  <h1 style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;">EuroPython 2026 Bingo</h1>

  <div class="bingo-page">
    <div class="bingo-header">
      <div class="bingo-title">EuroPython<br />Bingo</div>
      <p class="bingo-lead">
        25 editions &middot; 13 cities &middot; One community
      </p>
    </div>

    <BingoCard client:load />

    <p class="bingo-link-home">
      <a href="/#bingo">Back to home &rarr;</a>
    </p>
  </div>
</body>
</html>
