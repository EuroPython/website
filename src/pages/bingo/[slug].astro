---
import { BINGO_LINES } from "@data/bingoCodes";
import { EDITIONS, UNIQUE_CITIES, EDITION_COUNT } from "@data/editions";

export async function getStaticPaths() {
  return BINGO_LINES.map((line) => ({
    params: { slug: line.code },
    props: { line },
  }));
}

const { line } = Astro.props;
const winSet = new Set(line.cells);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EuroPython 2026 Bingo — I completed {line.label}!</title>
  <meta name="description" content={`I completed ${line.label} on the EuroPython 2026 Bingo card — 25 editions, 13 cities, one community. How many have you attended?`} />
  <meta property="og:title" content={`EuroPython 2026 Bingo — I completed ${line.label}!`} />
  <meta property="og:description" content={`I completed ${line.label} on the EuroPython 2026 Bingo card — 25 editions, 13 cities, one community. How many have you attended?`} />
  <meta property="og:site_name" content="EuroPython 2026" />
  <meta property="og:image" content={new URL("/bingo-cards/" + line.code + ".png", Astro.url)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={new URL("/bingo/" + line.code , Astro.url)} />
  <link rel="canonical" href={new URL("/bingo/" + line.code , Astro.url)} />
  <meta property="og:image:alt" content={`EuroPython 2026 Bingo — I completed ${line.label}!`} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:site" content="@europython" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0b1121" />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "EuroPython 2026 Bingo — I completed {line.label}!",
  "description": "I completed {line.label} on the EuroPython 2026 Bingo card — 25 editions, 13 cities, one community. How many have you attended?",
}
</script>

  <style is:global>
    :root {
      --color-accent: #f0c040;
      --color-on-accent: #0b1121;
      --color-bg-dark: #0b1121;
      --color-surface-faint: #0d1520;
      --color-text-primary: #ffffff;
      --color-text-secondary: rgba(255,255,255,0.6);
      --color-text-muted: rgba(255,255,255,0.45);
      --color-text-faint: rgba(255,255,255,0.35);
      --color-border: rgba(255,255,255,0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--color-bg-dark); min-height: 100vh; font-family: system-ui, sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1rem; color: var(--color-text-primary); }

    .bingo-page {
      width: 100%;
      max-width: 1200px;
    }

    .bingo-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .bingo-title {
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.03em;
      color: var(--color-accent);
      margin: 0 0 0.5rem;
      line-height: 0.95;
    }

    .bingo-lead {
      font-size: 1.15rem;
      color: var(--color-text-secondary);
      max-width: 440px;
      margin: 0 auto 0.5rem;
      line-height: 1.6;
    }

    .bingo-completed {
      font-size: 1rem;
      color: var(--color-text-muted);
      margin: 0;
    }

    .bingo-completed .highlight {
      color: var(--color-accent);
      font-weight: 700;
    }

    .grid-wrap {
      max-width: 520px;
      margin: 0 auto;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
    }

    .cell {
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      padding: 4px;
      text-align: center;
      gap: 1px;
    }

    .cell.win {
      background: var(--color-accent);
    }

    .cell.normal {
      background: var(--color-surface-faint);
      border: 1px dashed var(--color-border);
    }

    .year {
      font-size: clamp(0.75rem, 2.5vw, 0.95rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
    }

    .cell.win .year {
      color: var(--color-on-accent);
    }

    .cell.normal .year {
      color: var(--color-text-primary);
    }

    .city {
      font-size: clamp(0.45rem, 1.4vw, 0.6rem);
      line-height: 1;
    }

    .cell.win .city {
      color: var(--color-on-accent);
      opacity: 0.65;
    }

    .cell.normal .city {
      color: var(--color-text-faint);
    }

    .bingo-cta {
      text-align: center;
      margin-top: 2rem;
    }

    .bingo-cta a {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.15s;
    }

    .bingo-cta a:hover {
      opacity: 0.7;
    }
  </style>
</head>
<body>
  <h1 style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;">EuroPython 2026 Bingo — I completed {line.label}!</h1>

  <div class="bingo-page">
    <div class="bingo-header">
      <div class="bingo-title">EuroPython<br />Bingo</div>
      <p class="bingo-lead">
        {EDITION_COUNT} editions &middot; {UNIQUE_CITIES} cities &middot; One community
      </p>
      <p class="bingo-completed">Completed <span class="highlight">{line.label}</span></p>
    </div>

    <div class="grid-wrap">
      <div class="grid">
        {EDITIONS.map((ed, i) => (
          <div class:list={["cell", winSet.has(i) ? "win" : "normal"]}>
            <span class="year">{ed.year}</span>
            <span class="city">{ed.city}</span>
          </div>
        ))}
      </div>
    </div>

    <p class="bingo-cta">
      <a href="/#bingo">Play your own card &rarr;</a>
    </p>
  </div>
</body>
</html>
