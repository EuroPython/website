---
import Layout from "../layouts/Layout.astro";
import Headline from "@ui/Headline.astro"
import Section from "@ui/Section.astro";

import { Image } from "astro:assets";

const imageStyle = "m-2 md:float-right lg:float-none max-w-[300px] md:max-w-[400px] lg:max-w-[400px] w-full border-4 border-white rounded-lg shadow-lg ";
---

<Layout
  title="EuroPython 2026 | July 13th-19th 2026 | Kraków, Poland"
  description="EuroPython is the largest Python conference in Europe. We are looking forward to seeing you in Prague, Czech Republic & Remote from July 14th-20th 2025."
>
  <Section>
  <Headline id="oveview" as="h1" title="Programme & Events Overview" center=true />

  <div class="events-container w-full prose prose-xl">
    <div class="decorative-border"></div>

    <div class="events-grid">
      <div class="event-category">
        <h3>Talks, Tutorials & Posters</h3>

          <Image
              src="/overview/conference.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/sessions/">~120 talks</a></li>
          <li><a href="/sessions/">~20 tutorials</a></li>
          <li><a href="/sessions/">6 keynotes</a></li>
          <li><a href="/sessions/">10 posters</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Summits</h3>

          <Image
              src="/overview/summits.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/session/rust-summit/">Rust Summit</a></li>
          <li><a href="/session/webassembly-summit">WASM Summit</a></li>
          <li><a href="/session/c-api-summit/">C API Summit</a></li>
          <li><a href="/session/packaging-summit/">Packaging Summit</a></li>

        </ul>
      </div>

      <div class="event-category">
        <h3>PyLadies Sessions</h3>

          <Image
              src="/overview/pyladies-lunch.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/pyladies">PyLadies Lunch</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Beginner Workshops</h3>

          <Image
              src="/overview/hd.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/beginners-day#django-girls">Django Girls</a></li>
          <li><a href="/beginners-day#humble-data">Humble Data</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Community Organizers' Sessions</h3>

          <Image
              src="/overview/pyo.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="community-activities#community-organisers-open-space">Open space</a></li>
          <li><a href="/community-activities#community-organisers-lunch">Lunch</a></li>
          <li><a href="/community-activities#community-booths">Booths</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Social & Networking Events</h3>

          <Image
              src="/overview/social-event.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/speakers-dinner/">Speakers' dinner</a></li>
          <li><a href="/pyvo/">Wednesday Local Community Drinks</a></li>
          <li><a href="/beginners-day#beginners-day-unconference">Beginners’ Day Unconference</a></li>
          <li><a href="/social-event">Thursday social event</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Open spaces</h3>

          <Image
              src="/overview/open-spaces.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/pyladies#pyladies-open-space">PyLadies open space discussion</a></li>
          <li><a href="/pyladies#iamremarkable">PyLadies I'm remarkable workshop</a></li>
          <li>PyLadies stretching session</li>
          <li>3D printing workshop</li>
          <li>CV feedback session</li>
          <li>Python organizers open space discussion</li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Sprints</h3>

          <Image
              src="/overview/sprints.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/sprints">10+ open-source projects</a></li>
        </ul>
      </div>
    </div>

    <div class="decorative-border"></div>
  </div>
  </Section>
</Layout>

<style>
    :root {
      --primary-blue: #3A4CA3;
      --accent-pink: #F3B719;
      --bg-cream: #F7F1E6;
      --text-dark: #333;
    }
    .prose {
      max-width: initial;
    }
    .events-container {
      /*max-width: 1000px;*/
      margin: 0 auto;
      padding: 2rem;
      /*background-color: var(--bg-cream);*/
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .page-title {
      color: var(--primary-blue);
      font-size: 1.8rem;
      margin-top: 0;
    }

    .events-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
      gap: 2rem;
    }

    .event-category {
      margin-bottom: 2rem;
    }

    .event-category h3 {
      color: var(--primary-blue);
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      border-bottom: 4px solid var(--accent-pink);
      padding-bottom: 5px;
    }

    .event-list {
      list-style-type: none;
      padding-left: 0;
      margin: 0;
    }

    .event-list li {
      margin-bottom: 0.5rem;
      position: relative;
      padding-left: 20px;
    }

    .event-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--accent-pink);
      font-weight: bold;
    }

    .decorative-border {
      height: 16px;
      background-image: url('/hr.png');

      margin: 20px 0;
      border-radius: 3px;
    }

    @media (max-width: 768px) {
      .header {
        flex-direction: column;
        text-align: center;
      }

      .logo-container {
        margin-bottom: 1rem;
      }

      .events-grid {
        grid-template-columns: 1fr;
      }
    }
</style>
