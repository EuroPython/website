---
import { type CollectionEntry, getCollection, getEntry } from "astro:content";
import Layout from "@layouts/MarkdownLayout.astro";
import CompanyCard from "@components/CompanyCard.astro";

const companies = await getCollection("companies");

const jobFiles = import.meta.glob("../content/companies/*/!(index).md");
const companiesJobsMap: Record<string, CollectionEntry<"jobs">[]> = {};

for (const path in jobFiles) {
  const match = path.match(/\.\.\/content\/companies\/([^/]+)\/([^/]+)\.md$/);
  if (match) {
    const companyId = match[1];
    const jobId = match[2];

    const entry = await getEntry("jobs", `${companyId}/${jobId}`);
    if (entry) {
      if (!companiesJobsMap[companyId]) {
        companiesJobsMap[companyId] = [];
      }
      companiesJobsMap[companyId].push(entry);
    } else {
      console.warn(`Job entry not found for: ${companyId}/${jobId}`);
    }
  }
}

const companiesWithDescription: CollectionEntry<"companies">[]  = companies.filter(c => c.data.description?.trim());
const companiesWithoutDescription: CollectionEntry<"companies">[] = companies.filter(c => !c.data.description?.trim());
---

<Layout
  title="EuroPython 2025 | July 14th-20th 2025 | Prague, Czech Republic & Remote"
  description="EuroPython is the largest Python conference in Europe. We are looking forward to seeing you in Prague, Czech Republic & Remote from July 14th-20th 2025."
>
{companiesWithDescription.length > 0 && (
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 p-4 md:p-6">
    {companiesWithDescription.map((company) => (
      <CompanyCard company={company} />
    ))}
  </section>
)}

{companiesWithoutDescription.length > 0 && (
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 p-4 md:p-6">
    {companiesWithoutDescription.map((company) => (
      <CompanyCard company={company} />
    ))}
  </section>
)}
</Layout>
