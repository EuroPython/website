---
import Layout from "../layouts/Layout.astro";
import Headline from "@ui/Headline.astro"
import Section from "@ui/Section.astro";

import { Image } from "astro:assets";

const imageStyle = "m-2 md:float-right lg:float-none max-w-[300px] md:max-w-[400px] lg:max-w-[400px] w-full border-4 border-white rounded-lg shadow-lg ";
---

<Layout
  title="Programme & Events Overview | EuroPython 2026 | July 13th-19th 2026 | Kraków, Poland"
  description="An overview of the talks, tutorials, summits and community events happening at EuroPython 2026 in Kraków, Poland."
>
  <Section>
  <Headline id="overview" as="h1" title="Programme & Events Overview" center=true />

  <div class="events-container w-full prose prose-xl">
    <div class="decorative-border"></div>

    <div class="events-grid">
      <div class="event-category">
        <h3>Talks, Tutorials & Posters</h3>

          <Image
            src="/overview/conference.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/sessions/">Talks</a></li>
          <li><a href="/sessions/">Tutorials</a></li>
          <li><a href="/sessions/">Keynotes</a></li>
          <li><a href="/sessions/">Posters</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>Summits</h3>

          <Image
            src="/overview/summits.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/language-summit/">Language Summit</a></li>
          <li><a href="/packaging-summit/">Packaging Summit</a></li>
          <li><a href="/rust-summit/">Rust Summit</a></li>
        </ul>
      </div>

      <div class="event-category">
        <h3>PyLadies Events</h3>

          <Image
            src="/overview/pyladies-lunch.jpg"
            alt=""
            height={250}
            width={250}
            class={imageStyle}
          />

        <ul class="event-list">
          <li><a href="/pyladies">PyLadies Booth</a></li>
          <li><a href="/pyladies">PyLadies Workshops</a></li>
          <li><a href="/pyladies">PyLadies Lunch</a></li>
          <li><a href="/pyladies">Organizer Open Space</a></li>
        </ul>
      </div>
    </div>

    <div class="decorative-border"></div>
  </div>
  </Section>
</Layout>

<style>
    :root {
      --primary-blue: #3A4CA3;
      --accent-pink: #F3B719;
      --bg-cream: #F7F1E6;
      --text-dark: #333;
    }
    .prose {
      max-width: initial;
    }
    .events-container {
      margin: 0 auto;
      padding: 2rem;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .page-title {
      color: var(--primary-blue);
      font-size: 1.8rem;
      margin-top: 0;
    }

    .events-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
      gap: 2rem;
    }

    .event-category {
      margin-bottom: 2rem;
    }

    .event-category h3 {
      color: var(--primary-blue);
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      border-bottom: 4px solid var(--accent-pink);
      padding-bottom: 5px;
    }

    .event-list {
      list-style-type: none;
      padding-left: 0;
      margin: 0;
    }

    .event-list li {
      margin-bottom: 0.5rem;
      position: relative;
      padding-left: 20px;
    }

    .event-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--accent-pink);
      font-weight: bold;
    }

    .decorative-border {
      height: 16px;
      background-image: url('/hr.png');

      margin: 20px 0;
      border-radius: 3px;
    }

    @media (max-width: 768px) {
      .header {
        flex-direction: column;
        text-align: center;
      }

      .logo-container {
        margin-bottom: 1rem;
      }

      .events-grid {
        grid-template-columns: 1fr;
      }
    }
</style>
