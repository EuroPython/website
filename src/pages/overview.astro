---
import Layout from "@layouts/Layout.astro";
import Section2 from "@ui/Section2.astro";
import SessionHeader from "@sections/SessionHeader.astro";
import EventSection from "@sections/EventSection.astro";
import Programme from "@sections/programme.astro";
import EuroSciPy from "@sections/euroscipy.astro";
import Connect from "@sections/connect.astro";
import { getEntry, render } from "astro:content";

const talkHeader = await getEntry("programme", "talks/header");
const tutorialHeader = await getEntry("programme", "tutorials/header");
const posterHeader = await getEntry("programme", "posters/header");
const lightningHeader = await getEntry("programme", "lightning-talks/header");
const openSpacesHeader = await getEntry("programme", "open-spaces/header");

const eventEntries = [
  await getEntry("programme", "language_summit/event"),
  await getEntry("programme", "packaging_summit/event"),
  await getEntry("programme", "rust_summit/event"),
  await getEntry("programme", "wasm_summit/event"),
  await getEntry("programme", "pyladies/event"),
  await getEntry("programme", "community_day/event"),
];

const ACCENT_MAP: Record<string, string> = {
  language_summit: "capi",
  packaging_summit: "pkg",
  rust_summit: "rust",
  wasm_summit: "wasm",
  pyladies: "pyladies",
  community_day: "community",
};

const eventSections = await Promise.all(
  eventEntries.filter(Boolean).map(async (entry) => {
    const { Content } = await render(entry as any);
    const slug = entry!.id.split("/")[0];
    return {
      data: entry!.data,
      Content,
      accent: ACCENT_MAP[slug],
      highlight: (entry!.data as any).highlight,
    };
  }),
);
---

<Layout
  title="Programme Overview | EuroPython 2026"
  description="A week of talks, tutorials, posters, and more at EuroPython 2026 in Kraków, Poland."
>
  <Programme />

  <Section2 variant="dark" id="sessions">
    <div class="session-group">
      <SessionHeader
        id="talks"
        title={talkHeader!.data.title}
        subtitle={talkHeader!.data.subtitle!}
        metaItems={talkHeader!.data.meta}
        advantages={talkHeader!.data.advantages}
        cta={talkHeader!.data.cta}
        track="talk"
        highlight={talkHeader!.data.highlight}
      />
    </div>

    <div class="session-group">
      <SessionHeader
        id="tutorials"
        title={tutorialHeader!.data.title}
        subtitle={tutorialHeader!.data.subtitle!}
        metaItems={tutorialHeader!.data.meta}
        advantages={tutorialHeader!.data.advantages}
        cta={tutorialHeader!.data.cta}
        track="tutorial"
        highlight={tutorialHeader!.data.highlight}
      />
    </div>

    <div class="session-group">
      <SessionHeader
        id="posters"
        title={posterHeader!.data.title}
        subtitle={posterHeader!.data.subtitle!}
        metaItems={posterHeader!.data.meta}
        advantages={posterHeader!.data.advantages}
        cta={posterHeader!.data.cta}
        track="poster"
        highlight={posterHeader!.data.highlight}
      />
    </div>

    <div class="session-group">
      <SessionHeader
        id="lightning-talks"
        title={lightningHeader!.data.title}
        subtitle={lightningHeader!.data.subtitle!}
        metaItems={lightningHeader!.data.meta}
        advantages={lightningHeader!.data.advantages}
        track="lightning"
        highlight={lightningHeader!.data.highlight}
      />
    </div>

    <div class="session-group">
      <SessionHeader
        id="open-spaces"
        title={openSpacesHeader!.data.title}
        subtitle={openSpacesHeader!.data.subtitle!}
        metaItems={openSpacesHeader!.data.meta}
        advantages={openSpacesHeader!.data.advantages}
        track="open"
        highlight={openSpacesHeader!.data.highlight}
      />
    </div>
  </Section2>

  <Section2 variant="dark-alt" id="events">
    {
      eventSections.map(({ data, Content, accent, highlight }) => (
        <div class="event-group">
          <EventSection
            id={data
              .title!.toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/-$/g, "")}
            title={data.title!}
            subtitle={data.subtitle}
            meta={data.meta}
            startDatetime={data.start_datetime}
            endDatetime={data.end_datetime}
            location={data.location}
            contact={data.contact}
            link={data.link}
            accent={accent as any}
            highlight={highlight}
          >
            <Content />
          </EventSection>
        </div>
      ))
    }
  </Section2>

  <EuroSciPy />

  <Connect />
</Layout>

<style>
  .session-group + .session-group {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px dashed var(--color-border);
  }

  .events-heading {
    color: var(--color-text);
  }

  .event-group + .event-group {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px dashed var(--color-border);
  }
</style>
