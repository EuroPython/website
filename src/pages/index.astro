---

<Layout
  title="EuroPython 2026 | July 13th-19th 2026 | Kraków, Poland"
  description="EuroPython is the largest Python conference in Europe. We are looking forward to seeing you in Kraków, Poland from July 13th-19th 2026."
>
  <div class="section-universe">
    <Hero />
    <History />
    <!-- <Week /> -->
    <EuroSciPy />
    <Updates />
  </div>
  <Programme />
  <Krakow />
  <IceVenue />
  <Testimonials />
  <CommunityPartners />
  <!-- <Speakers /> -->
  <!-- <City /> -->
  <Sponsors />
  <CommunityPartners />
  <FinAid />
  <PyLadies />
  <OrgSummit />
  <Ep25 />
  <Connect />

</Layout>

<style>
  :global(body) {
    padding-top: 0 !important;
  }
  :global(main) {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }
</style>
