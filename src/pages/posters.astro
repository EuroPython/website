---
import Layout from "@layouts/Layout.astro";
import Section2 from "@ui/Section2.astro";
import Title from "@ui/Title.astro";
import { getCollection, getEntry } from "astro:content";
import ListPosters from "@components/sessions/list-posters.astro";

const featuresEntry = await getEntry("pages", "posters");

const allSessions = await getCollection("sessions");
const posters = allSessions
  .filter((s) => s.data.session_type?.toLowerCase() === "poster")
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Posters | EuroPython 2026" description="A visual showcase of projects, research, and ideas — presented in person during a dedicated poster session.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=block" rel="stylesheet">
  </Fragment>
  <Section2 variant="dark" id="posters">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-12">
        <Title id="posters" subtitle="A visual showcase of projects, research, and ideas — presented in person during a dedicated poster session.">
          POSTERS
        </Title>
        <div class="flex justify-center gap-6 text-sm text-white/50 mt-4">
          <span>During the main conference</span>
          <span>Exhibition area</span>
        </div>
      </div>

      <!-- Advantages grid -->
      <ul class="poster-advantages">
        {featuresEntry && ["box1", "box2", "box3", "box4"].map((box) => {
          const text = featuresEntry.data[box as keyof typeof featuresEntry.data];
          if (!text) return null;
          const [title, ...rest] = text.split(" — ");
          return (
            <li>
              <strong>{title}</strong>
              {rest.join(" — ")}
            </li>
          );
        })}
      </ul>

      <!-- Poster list component -->
      <ListPosters posters={posters} />

    </div>
  </Section2>
    </div>
  </Section2>
</Layout>

<style>
  .poster-advantages {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  @media (min-width: 640px) {
    .poster-advantages {
      grid-template-columns: 1fr 1fr;
    }
  }

  .poster-advantages li {
    padding: 1.6rem;
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .poster-advantages li strong {
    display: block;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
</style>
