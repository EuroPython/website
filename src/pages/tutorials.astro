---
import Layout from "@layouts/Layout.astro";
import Section2 from "@ui/Section2.astro";
import Title from "@ui/Title.astro";
import { getCollection, getEntry } from "astro:content";
import SessionCard from "@components/SessionCard.astro";

const featuresEntry = await getEntry("pages", "tutorials");

const allSessions = await getCollection("sessions");

// Pre-resolve all speakers for fast lookup
const allSpeakers = await getCollection("speakers");
const speakerNames: Record<string, string> = {};
for (const s of allSpeakers) {
  speakerNames[s.id] = s.data.name;
}

function speakerHtml(speakers: any): string {
  if (!speakers || speakers.length === 0) return "";
  return speakers.map((s: any) => {
    const id = typeof s === "string" ? s : s.id;
    const name = speakerNames[id] || id;
    return `<a href="/speaker/${id}" class="speaker-link">${name}</a>`;
  }).join(", ");
}
const tutorials = allSessions
  .filter((s) => s.data.session_type?.toLowerCase() === "tutorial")
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Tutorials | EuroPython 2026" description="Full-day, hands-on workshops led by domain experts. Go deeper than any talk can — bring your laptop and leave with real skills.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=block" rel="stylesheet">
  </Fragment>

  <Section2 variant="dark" id="tutorials">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-12">
        <Title id="tutorials" subtitle="Full-day, hands-on workshops led by domain experts. Go deeper than any talk can — bring your laptop and leave with real skills.">
          TUTORIALS
        </Title>
        <div class="flex justify-center gap-6 text-sm text-white/50 mt-4">
          <span>Monday & Tuesday, July 13–14</span>
          <span>Small-group format</span>
        </div>
      </div>

      <!-- Advantages grid -->
      <ul class="tutorial-advantages">
        {featuresEntry && ["box1", "box2", "box3", "box4"].map((box) => {
          const text = featuresEntry.data[box as keyof typeof featuresEntry.data] as string | undefined;
          if (!text) return null;
          const [title, ...rest] = text.split(" — ");
          return (
            <li>
              <strong>{title}</strong>
              {rest.join(" — ")}
            </li>
          );
        })}
      </ul>

      <!-- Tutorial count -->
      <p class="tutorials-count"><span id="sess-count">{tutorials.length}</span> tutorials at EuroPython 2026</p>

      <!-- Filter bar -->
      <div class="sess-filters">
        <input type="text" id="sess-search" class="sess-search" placeholder="Filter by title or speaker..." autocomplete="off" aria-label="Filter tutorials by title or speaker">
      </div>

      <!-- Tutorials list -->
      <div class="tutorials-section" id="sess-grid">
        <div class="talks-dot-bg">
          <div class="tutorial-grid">
            {tutorials.map((t) => (
              <SessionCard
                  title={t.data.title}
                  slug={t.id}
                  speakers={speakerHtml(t.data.speakers)}
                  duration={t.data.duration}
                  level={t.data.level}
                  track={t.data.track}
                  searchText={`${t.data.title} ${t.data.track || ""}`}
                />
            ))}
          </div>
        </div>
      </div>

      <p class="sess-no-results" id="sess-no-results" hidden>No tutorials match your search.</p>

    </div>
  </Section2>
</Layout>

<style>
  .tutorial-advantages {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  @media (min-width: 640px) {
    .tutorial-advantages {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tutorial-advantages li {
    padding: 1.6rem;
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .tutorial-advantages li strong {
    display: block;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .tutorials-count {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    text-align: center;
  }

  .sess-filters {
    display: flex;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto 2.5rem;
  }

  .sess-search {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1.2rem;
    font-size: 1.1rem;
    color: var(--color-text);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    outline: none;
  }

  .sess-search::placeholder {
    color: var(--color-text-faint);
  }

  .sess-search:focus {
    border-color: var(--color-accent);
    background: var(--color-surface-medium);
  }

  .sess-no-results {
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    padding: 3rem;
  }

  .tutorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
</style>

<script is:inline>
(function() {
  var input = document.getElementById('sess-search');
  if (!input) return;
  var grid = document.getElementById('sess-grid');
  var cards = grid.querySelectorAll('.session-card');
  var countEl = document.getElementById('sess-count');
  var noResults = document.getElementById('sess-no-results');
  var total = cards.length;

  function filterCards() {
    var q = input.value.toLowerCase().trim();
    var visible = 0;

    cards.forEach(function(card) {
      var show = !q || card.getAttribute('data-search').indexOf(q) !== -1;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    countEl.textContent = (q) ? visible + ' / ' + total : total;
    if (noResults) noResults.hidden = visible > 0;
  }

  input.addEventListener('input', filterCards);
})();
</script>
