---
import Layout from "@layouts/Layout.astro";
import Section2 from "@ui/Section2.astro";
import BingoCard from "@components/island/BingoCard.svelte";
---

<Layout
  title="EuroPython Bingo | How many have you attended?"
  description="25 editions, 13 cities, one community. Check off every EuroPython conference you've been to and share your card!"
  image="/social-card-bingo.png"
>
  <Section2 variant="dark" id="bingo">
    <div class="bingo-page">
      <div class="bingo-header">
        <h1 class="bingo-title">EuroPython<br />Bingo</h1>
        <p class="bingo-lead">
          25 editions. 13 cities. One community.<br />
          How many have you attended?
        </p>
      </div>

      <BingoCard client:load />
    </div>
  </Section2>
</Layout>

<style>
  .bingo-page {
    padding: 3rem 0 4rem;
  }

  .bingo-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .bingo-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    margin: 0 0 1.25rem;
    line-height: 0.95;
  }

  .bingo-lead {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.6;
  }
</style>
