---
import { getCollection, getEntries } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Prose from "@ui/Prose.astro";
import { Image } from "astro:assets";
import Markdown from "@ui/Markdown.astro";
import Title from "@ui/Title.astro";
import Section2 from "@ui/Section2.astro"
import CodeHeart from "@components/island/CodeHeart.svelte";


export async function getStaticPaths() {
  const entries = await getCollection("speakers");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const sessions = await getEntries(entry.data.submissions);

function isUrl(str: string): boolean {
  str = ensureHttps(str);
  const regex = /^(https?:\/\/)?([a-zA-Z0-9.-]+)\.([a-zA-Z]{2,6})([\/\w@.-]*)$/;
  return regex.test(str);
}

function ensureHttps(str: string): string {
  if (!/^https?:\/\//i.test(str)) {
    return "https://" + str;
  }
  return str;
}

// Get @username from Twitter URL
function getTwitterUsername(url: string): string | undefined {
  const username = url.split("/").pop();
  return (username ?? url).startsWith("@") ? username : `@${username}`;
}

function getBlueskyUsername(url: string): string | undefined {
  const username = url.split("/").pop()?.replace(/^@/, "");
  return username ? `@${username}` : undefined;
}

function getBlueskyProfileLink(username: string): string {
  // Remove any leading @ if present
  const cleanUsername = username.replace(/^@/, "");
  return `https://bsky.app/profile/${cleanUsername}`;
}

// Get @username@instance.tld from Mastodon URL
function getMastodonUsername(url: string): string | null {
  const match = url.match(/https?:\/\/([^\/]+)\/@([^\/]+)(\/|\?|$)/);
  return match ? `@${match[2]}@${match[1]}` : null;
}

// Get in/username from LinkedIn URL
function getLinkedInUsername(url: string): string | null {
  const match = url.match(/https?:\/\/([^\/]+)\/in\/([^\/]+)(\/|\?|$)/);
  if (match) {
    try {
      return `in/${decodeURIComponent(match[2])}`;
    } catch {
      return `in/${match[2]}`;
    }
  }
  return null;
}

// Get Git hosting service from URL
function getGitHosting(url: string): string | undefined {
  const urlWithProtocol = ensureHttps(url);
  try {
    const hostname = new URL(urlWithProtocol).hostname;
    if (hostname.includes("github.com")) return "GitHub";
    if (hostname.includes("gitlab.com")) return "GitLab";
  } catch {
    return undefined;
  }
  return undefined;
}
---

<Layout title={entry.data.name} description={`Profile of ${entry.data.name}`}>
  <Section2 variant="dark" id="speaker-page">
    <Title id="speaker">{entry.data.name}</Title>

              <div class="md:grid grid-cols-[460px_1fr] md:gap-6">
    {
      ( entry.data.avatar &&
                  <div class="flex items-start">
                    <div class="speaker-profile-photo border-4 border-white rounded-lg shadow-lg inline-block mb-10">
          <Image
            src={entry.data.avatar}
            alt={entry.data.name}
            height={400}
            width={300}
            class="speaker-profile-img"
          />
        </div>
        </div>
      )
    }
                </div>

    {
      entry.data.biography ? (
        <>
          <h2 class="relative font-heading text-white font-bold mb-[0.6em] [&>a]:border-0 [&>a]:text-inherit text-5xl">
            Biography
          </h2>
          <Prose full>
            <Markdown content={entry.data.biography} />
          </Prose>
        </>
      ) : null
    }

    <Prose full>
    {
      entry.data.affiliation ||
      entry.data.homepage ||
      entry.data.gitx_url ||
      entry.data.linkedin_url ||
      entry.data.mastodon_url ||
      entry.data.twitter_url ? (
        <div class="mb-4">
          <h2 class="relative font-heading text-white font-bold mb-[0.6em] [&>a]:border-0 [&>a]:text-inherit text-5xl">
            More about the speaker
          </h2>
          <dl>
            {entry.data.affiliation && (
              <>
                <dt class="font-bold">Affiliation</dt>
                <dd>{entry.data.affiliation}</dd>
              </>
            )}

            {entry.data.homepage && (
              <>
                <dt class="font-bold">Homepage</dt>
                <dd>
                  {isUrl(entry.data.homepage) ? (
                    <a
                      href={ensureHttps(entry.data.homepage)}
                      class="text-white/80 underline hover:text-accent"
                      target="_blank"
                    >
                      {entry.data.homepage}
                    </a>
                  ) : (
                    <span>{entry.data.homepage}</span>
                  )}
                </dd>
              </>
            )}

            {entry.data.gitx_url && (
              <>
                <dt class="font-bold">
                  {getGitHosting(entry.data.gitx_url) ?? "Git"}
                </dt>
                <dd>
                  <a
                    href={ensureHttps(entry.data.gitx_url)}
                    class="text-white/80 underline hover:text-accent"
                      target="_blank"
                  >
                    {entry.data.gitx_url}
                  </a>
                </dd>
              </>
            )}

            {entry.data.linkedin_url && (
              <>
                <dt class="font-bold">LinkedIn</dt>
                <dd>
                  <a
                    href={entry.data.linkedin_url}
                    class="text-white/80 underline hover:text-accent"
                      target="_blank"
                  >
                    {getLinkedInUsername(entry.data.linkedin_url)}
                  </a>
                </dd>
              </>
            )}

            {entry.data.mastodon_url && (
              <>
                <dt class="font-bold">Mastodon</dt>
                <dd>
                  <a
                    href={entry.data.mastodon_url}
                    class="text-white/80 underline hover:text-accent"
                      target="_blank"
                  >
                    {getMastodonUsername(entry.data.mastodon_url)}
                  </a>
                </dd>
              </>
            )}

            {entry.data.twitter_url && (
              <>
                <dt class="font-bold">Twitter / X</dt>
                <dd>
                  <a
                    href={entry.data.twitter_url}
                    class="text-white/80 underline hover:text-accent"
                      target="_blank"
                  >
                    {getTwitterUsername(entry.data.twitter_url)}
                  </a>
                </dd>
              </>
            )}
            {entry.data.bluesky_url && (
              <>
                <dt class="font-bold">Bluesky</dt>
                <dd>
                  <a
                    href={getBlueskyProfileLink(getBlueskyUsername(entry.data.bluesky_url) as string)}
                    class="text-white/80 underline hover:text-accent"
                      target="_blank"
                  >
                    {getBlueskyUsername(entry.data.bluesky_url)}
                  </a>
                </dd>
              </>
            )}
          </dl>
        </div>
      ) : null
    }
    </Prose>

    <br />

    <h2
      class="relative font-heading text-white font-bold mb-[0.6em] [&>a]:border-0 [&>a]:text-inherit text-5xl"
    >
      Session{sessions.length > 1 ? "s" : ""}
    </h2>
    <ul class="mb-4 pl-6 list-decimal">
      {
        sessions.map((session) => (
          <li class="mb-2 text-xl leading-snug">
            <a
              class="text-white/80 hover:text-accent underline font-semibold"
              href={`/session/${session.id}`}
            >
              {session.data.title}
            </a>

  <CodeHeart
    client:load
    mini={true}
    codeId={session.data.code}
    title={session.data.title}
  />
          </li>
        ))
      }
    </ul>
  </Section2>
</Layout>

<style>

  .speaker-profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

dl,
dd, dt {
  font-size: 1.1rem;
  color: var(--color-text-primary-dark, rgba(255,255,255,0.93));
}

  </style>
