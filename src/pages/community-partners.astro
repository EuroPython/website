---
import { getCollection } from "astro:content";
import Layout from "@layouts/SectionLayout.astro";
import SponsorCard from "@components/SponsorCard.astro";
import Headline from "@ui/Headline.astro";
import Button from "@ui/Button.astro";

const sponsors = (
  await getCollection("sponsors", ({ data }) => {
    const isProd = import.meta.env.MODE === "production";
    const notDraft = !isProd || data.draft !== true;
    const isPartner = data.tier === "Partners";
    return notDraft && isPartner;
  })
).sort((a, b) => a.id.localeCompare(b.id));
---

<Layout
  title="EuroPython 2026 | July 13th-19th 2026 | Kraków, Poland"
  description="EuroPython is the largest Python conference in Europe. We are looking forward to seeing you in Prague, Czech Republic & Remote from July 14th-20th 2025."
>
  <Headline as="h1" id="community-partners" title="Community partners" />
  <p class="pb-5">
    EuroPython is a community-driven conference, we wouldn't be able to make as
    much impact without the support of our brilliant Community Partners. Get to
    know our partners better below (alphabetical order).
  </p>
  {
    sponsors.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sponsors.map((sponsor) => (
          <SponsorCard sponsor={sponsor.id} />
        ))}
      </div>
    )
  }
  <p class="pb-5">
    Are you a Python Community organiser, interested in knowing more about
    EuroPython Society? Feel free to reach out at <Button
      custom
      class="font-bold text-button-active hover:underline"
      url="mailto:board@europython.eu">board@europython.eu</Button
    >!
  </p></Layout
>
