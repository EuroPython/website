---
import Layout from "@layouts/Layout.astro";
import Section from "@ui/Section.astro";
import { slugify } from '@utils/content';
import InstallPWA from "@components/InstallPWA.astro";

export interface Props {
  title?: string;
  description: string;
  headline: string;
}

const { title, description, headline } = Astro.props;
---
<Layout title={title || "Schedule for 2026"} description={description} >
  <Fragment slot="head">
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <link rel="mask-icon" href="/maskable_icon.png" color="#d4003a">
    <meta name="msapplication-TileColor" content="#d4003a">
    <meta name="theme-color" content="#080002">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=block" rel="stylesheet">
  </Fragment>

  <div class="ep-sched-section">
  <div class="ep-sched-inner">
  <InstallPWA />
  <Section>
    <h1 class="ep-headline" id={slugify(headline)}><a href={`#${slugify(headline)}`} aria-label={`Jump to ${headline}`}>{headline}</a></h1>

  <div class="ep-note">💚 Mark talks as favorites by opening their details and tapping the ❤️ icon. Your selections are saved locally and will only be visible on this device.</div>

  <div class="ep-legend">
    <span class="ep-legend-item"><span class="ep-legend-swatch ep-legend-default"></span> Talk</span>
    <span class="ep-legend-item"><span class="ep-legend-swatch ep-legend-beginner"></span> Beginner</span>
    <span class="ep-legend-item"><span class="ep-legend-swatch ep-legend-advanced"></span> Advanced</span>
    <span class="ep-legend-item"><span class="ep-legend-swatch ep-legend-break"></span> Break</span>
    <span class="ep-legend-item"><span class="ep-legend-swatch ep-legend-room-change"></span> Room Change</span>
  </div>

    <div class="layout-wrapper2">
      <slot />
    </div>
  </Section>
  </div>
  </div>
</Layout>

<style is:global>
/* Dark theme for schedule pages */
body {
  background: var(--ep-bg) !important;
  color: var(--ep-white);
}

.layout-wrapper2 > * {
  grid-column: 2;
}

/* Remove light theme background from body on schedule pages */
body {
  background-color: var(--color-primary) !important;
}

main {
  background-color: transparent !important;
}


/* Unset Tailwind light theme on schedule pages */
.text-gray-600, .text-gray-700, .text-gray-800, .text-gray-900,
.text-gray-500, .text-gray-400 {
  color: var(--ep-text-secondary) !important;
}

/* Nav items on dark background */
header#navbar .text-primary {
  color: var(--ep-text-primary) !important;
}

header#navbar .bg-\[\#1c294b\] {
  background: var(--ep-surface-medium) !important;
}

/* Schedule legend */
.ep-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  margin: 1.5rem 0;
  padding: 0.8rem 1rem;
  background: var(--ep-surface-subtle);
  border: 1px solid var(--ep-border);
  border-radius: 6px;
  font-family: 'Inter Tight', system-ui, sans-serif;
  font-size: 0.9rem;
  color: var(--ep-text-secondary);
}

.ep-legend-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.ep-legend-swatch {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  border: 1px solid var(--ep-border);
  flex-shrink: 0;
}

.ep-legend-default {
  background: var(--ep-surface-subtle);
}

.ep-legend-beginner {
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 2px,
    rgba(50,180,50,0.3) 2px,
    rgba(50,180,50,0.3) 4px
  );
  background-color: var(--ep-surface-subtle);
}

.ep-legend-advanced {
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 2px,
    rgba(200,50,50,0.3) 2px,
    rgba(200,50,50,0.3) 4px
  );
  background-color: var(--ep-surface-subtle);
}

.ep-legend-break {
  background: rgba(255,150,0,0.2);
  border-color: rgba(255,150,0,0.4);
}

.ep-legend-room-change {
  background: var(--ep-surface-subtle);
  border: 1px dashed var(--ep-border);
}

/* Breadcrumbs dark theme */
nav[aria-label="Breadcrumb"] .text-gray-900 {
  color: var(--ep-white) !important;
}

nav[aria-label="Breadcrumb"] a {
  color: var(--ep-link-color) !important;
}

/* Improve select appearance on dark */
select {
  background: var(--ep-surface-subtle);
  color: var(--ep-white);
  border: 1px solid var(--ep-border);
  border-radius: 4px;
  padding: 0.5rem;
}

@media screen and (min-width: 1281px) {
  .layout-wrapper2 .schedule * {
    font-size: 1.1rem;
    --header-height: 40px !important;
    --break: 10px !important;
  }

  .layout-wrapper2 h2, .layout-wrapper2 .break {
    font-size: 1.3rem;
  }
}

@media screen and (min-width: 1201px) {
  .layout-wrapper2.scaled-up .schedule * {
    font-size: 1.4rem;
    --header-height: 60px !important;
    --break: 14px !important;
  }
  .layout-wrapper2.scaled-up h2, .layout-wrapper2.scaled-up .break {
    font-size: 1.4rem;
  }
}
@media screen and (min-width: 1601px) {
  .maximize-btn {
    visibility: initial;
  }
}
</style>
