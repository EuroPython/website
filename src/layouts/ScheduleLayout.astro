---
import Layout from "@layouts/Layout.astro";
import Section from "@ui/Section.astro";
import Note from "@ui/Note.astro";
import Headline from "@ui/Headline.astro"
import { slugify } from '@utils/content';
import InstallPWA from "@components/InstallPWA.astro";

export interface Props {
  title?: string;
  description: string;
  headline: string;
}

const { title, description, headline } = Astro.props;
---
<Layout title={title || "Schedule for 2026"} description={description} >
  <Fragment slot="head">
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <link rel="mask-icon" href="/maskable_icon.png" color="#f5e5d6">
    <meta name="msapplication-TileColor" content="#f5e5d6">
    <meta name="theme-color" content="#f5e5d6">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=block" rel="stylesheet">
  </Fragment>

  <InstallPWA />
  <Section>
    <Headline as="h1"id={slugify(headline)} title={headline} />

  <Note type="info" >Mark talks as favorites by opening their details and tapping the ❤️ icon. Your selections are saved locally and will only be visible on this device.</Note>

    <div class="layout-wrapper2">
      <slot />
    </div>
  </Section>
</Layout>

<style is:global>
.layout-wrapper2 > * {
  grid-column: 2;
}


@media screen and (min-width: 1281px) {
  .layout-wrapper2 .schedule *{
    font-size:1.2rem;
    --header-height: 40px !important;
    --break: 10px !important;
  }

  .layout-wrapper2 {
    h2, .break {
    font-size:1.2rem;
    }
  }
}

@media screen and (min-width: 1201px) {

  .layout-wrapper2.scaled-up .schedule *{
    font-size:1.4rem;
    --header-height: 60px !important;
    --break: 14px !important;
  }
  .layout-wrapper2.scaled-up {
    h2, .break {
    font-size:1.4rem;
    }
  }
}
@media screen and (min-width: 1601px) {
  .maximize-btn {
    visibility:initial;
  }
}
</style>
