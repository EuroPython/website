---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Offline from "@components/Offline.astro";
import Breadcrumbs from '@components/Breadcrumbs.astro';

import linksData from '@src/data/links.json';

import "@fortawesome/fontawesome-free/css/all.min.css";
import "@styles/tailwind.css";
import "@styles/global.css";
import "@styles/search.css";


export interface Props {
  title: string;
  description: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const currentPath = Astro.url.pathname;

const { title, description } = Astro.props;

if (!title || !description) {
throw new Error(`${Astro.url.pathname} Both 'title' and 'description' must be set.`);
}

const externalDomain = new URL(Astro.site || "").hostname;

const hideHeader = Astro.props.hideHeader ?? false;
const hideFooter = Astro.props.hideFooter ?? false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
    </Fragment>
  </head>
  <body>
      {!hideHeader &&
        <header>
          <Header />
        </header>
      }

      <main class="main" role="main">
      <Offline />
        {currentPath !== "/" && (
          <Breadcrumbs
              linksData={linksData}
              currentPath={currentPath}
              homeLabel="EuroPython 2026"
              homePath="/"
              separator="›"
          />
        )}
        <slot />
      </main>


      <!-- if !hideFooter, show footer; if hideFooter, hide footer and -mb-256 -->
      {!hideFooter ?
        <footer>
          <Footer />
        </footer>
        :
        <div class="-mb-256"></div>
      }

  </body>
</html>


<style is:global define:vars={{ externalDomain }}>
  main section .container {
    max-width: 1150px;
  }

  article a[href^="http"]:not([href*="var(--externalDomain)"]):not(.button-link):not(:has(img))::after {
    font-size: 0.8em;
    content: " ↗";
  }

  article a[href^="http"]:not([href*="var(--externalDomain)"]):not(.button-link):not(:has(img)) {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>


<style>
body {
  min-width: 360px;
  margin: 0;
  padding: 0;
}

header {
  background-color: transparent;
  padding: 0;
}

nav#navbar {
  position: fixed;
}

main {
  background-color: transparent;
  padding-top: 0;
}

footer {
  background-color: #0c1628;
  padding-top: 2.5rem;
  padding-bottom: 2.5rem;
}

@media screen and (width>1200px){
  main {
    min-height: calc(100vh - 200px);
  }
}

@media all and (display-mode: standalone) {
  footer {
    display: none;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  if (window.matchMedia('(display-mode: standalone)').matches) {

    (document.querySelector('.home-link') as HTMLAnchorElement).href = '/schedule/?utm_source=pwa';

    document.addEventListener('click', function (e: Event) {

      const target = e.target as HTMLElement;
      const anchor = target.closest('a') as HTMLAnchorElement;

      if (!anchor || !anchor.href) return;

      const origin = window.location.origin;
      const href = anchor.getAttribute('href');

      if (!href) return;

      const normalizedHref = href.trim().toLowerCase();

      if (
        normalizedHref.startsWith('#') ||
        normalizedHref.startsWith('/') ||
        normalizedHref.startsWith(origin.toLowerCase()) ||
        (!normalizedHref.includes('://') && !normalizedHref.startsWith('//'))
      ) {
        return;
      }

      e.preventDefault();
      e.stopPropagation();

      const message = 'Please visit the website to access external content.';
      alert(message);

    }, { passive: false });
  }
});
</script>
